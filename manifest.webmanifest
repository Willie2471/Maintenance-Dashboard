<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#2d6a2f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="WS Maintenance">
<title>WS Lawn Care - Equipment Maintenance Portal</title>
<script>
/* Phone menu position: embedded in another page (e.g. Wix) -> menu on top, where it can always be reached.
   Opened directly -> menu on the bottom. Add ?nav=top or ?nav=bottom to the address to force either. */
(function(){var q=(location.search||'').match(/[?&]nav=(top|bottom)/),emb;
try{emb=window.self!==window.top;}catch(e){emb=true;}
if(q?q[1]==='top':emb)document.documentElement.classList.add('navtop');})();
</script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,-apple-system,sans-serif;background:#f4f7f4;color:#1a2e1a;font-size:14px;height:100vh;overflow:hidden}
:root{--gd:#2d6a2f;--gm:#3d8b40;--gl:#e8f5e9;--gb:#c8e6c9;--am:#e65100;--al:#fff3e0;--rd:#c62828;--rl:#ffebee;--bl:#1565c0;--gr:#546e7a;--grl:#eceff1;--wh:#fff;--br:#dde5dd;--ra:8px;--rlg:12px;--sh:0 1px 4px rgba(0,0,0,.08)}
.app{display:flex;height:100vh;overflow:hidden}
.sidebar{width:230px;background:var(--gd);color:#fff;display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.sidebar-logo{padding:20px 18px 14px;border-bottom:1px solid rgba(255,255,255,.15)}
.s-brand{font-size:15px;font-weight:700;line-height:1.3}
.s-tagline{font-size:10px;opacity:.65;margin-top:2px}
.nav-label{font-size:10px;opacity:.45;text-transform:uppercase;letter-spacing:1px;padding:10px 18px 4px;font-weight:600}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 18px;cursor:pointer;font-size:13px;opacity:.78;transition:all .15s;border-left:3px solid transparent}
.nav-item:hover{background:rgba(255,255,255,.1);opacity:1}
.nav-item.active{background:rgba(255,255,255,.14);opacity:1;border-left-color:rgba(255,255,255,.7)}
.sidebar-bottom{margin-top:auto;padding:14px 18px;font-size:10px;opacity:.45;border-top:1px solid rgba(255,255,255,.1);line-height:1.7}
.sidebar{transition:width .2s ease}
.sidebar-logo{position:relative}
.sb-toggle{position:absolute;top:10px;right:10px;width:26px;height:26px;border:none;border-radius:6px;background:rgba(255,255,255,.14);color:#fff;font-size:17px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
.sb-toggle:hover{background:rgba(255,255,255,.28)}
.sidebar.collapsed{width:60px}
.sidebar.collapsed .sidebar-logo{padding:44px 0 8px;border-bottom:1px solid rgba(255,255,255,.15)}
.sidebar.collapsed .sb-toggle{right:17px}
.sidebar.collapsed .s-brand,.sidebar.collapsed .s-tagline,.sidebar.collapsed .nav-label,.sidebar.collapsed .sidebar-bottom{display:none}
.sidebar.collapsed .nav-item{padding:11px 0;justify-content:center;gap:0}
.sidebar.collapsed .nav-item span:not(.ni){display:none}
.sidebar.collapsed .nav-item .ni{font-size:17px}
.main{flex:1;overflow-y:auto;display:flex;flex-direction:column;min-width:0}
.topbar{background:var(--wh);border-bottom:1px solid var(--br);padding:12px 22px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;box-shadow:var(--sh)}
.topbar-title{font-size:17px;font-weight:700;color:var(--gd)}
.topbar-sub{font-size:11px;color:var(--gr);margin-top:1px}
.content{padding:20px;flex:1}
.page{display:none}.page.active{display:block}
.btn{border:none;border-radius:var(--ra);padding:7px 14px;font-size:13px;cursor:pointer;font-weight:500;display:inline-flex;align-items:center;gap:6px;transition:all .15s}
.btn-primary{background:var(--gd);color:#fff}.btn-primary:hover{background:var(--gm)}
.btn-secondary{background:var(--grl);color:#2c3e2c;border:1px solid var(--br)}.btn-secondary:hover{background:#d7dde0}
.btn-danger{background:var(--rl);color:var(--rd)}.btn-danger:hover{background:#ffcdd2}
.btn-amber{background:var(--al);color:var(--am)}
.btn-sm{padding:4px 10px;font-size:12px}
.btn-xs{padding:2px 7px;font-size:11px}
.card{background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);padding:16px;box-shadow:var(--sh)}
.card-title{font-size:13px;font-weight:700;color:var(--gd);margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:8px}
.card-title span{font-weight:400;color:var(--gr);font-size:11px}
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}
.kpi{background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);padding:14px 12px;box-shadow:var(--sh)}
.kpi-label{font-size:10px;color:var(--gr);text-transform:uppercase;letter-spacing:.6px;font-weight:600;margin-bottom:4px}
.kpi-val{font-size:28px;font-weight:700;line-height:1}
.kpi-sub{font-size:10px;margin-top:4px;opacity:.8}
.kpi-g .kpi-val{color:var(--gd)}.kpi-r .kpi-val{color:var(--rd)}.kpi-a .kpi-val{color:var(--am)}.kpi-b .kpi-val{color:var(--bl)}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.alert-item{display:flex;align-items:flex-start;gap:8px;padding:7px 10px;border-radius:var(--ra);margin-bottom:5px;font-size:12px;cursor:pointer}
.a-ov{background:var(--rl);border-left:3px solid var(--rd)}
.a-du{background:var(--al);border-left:3px solid #ef6c00}
.a-ok{background:var(--gl);border-left:3px solid var(--gm)}
.alert-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:3px}
.dot-r{background:var(--rd)}.dot-a{background:#ef6c00}.dot-g{background:var(--gm)}
.eq-mini{display:flex;align-items:center;gap:8px;padding:7px;border-radius:var(--ra);border:1px solid var(--br);margin-bottom:5px;cursor:pointer}
.eq-mini:hover{border-color:var(--gm);background:var(--gl)}
#d-equip{max-height:360px;overflow-y:auto;padding-right:4px}
.mini-ico{width:32px;height:32px;background:var(--gl);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.mini-info{flex:1;min-width:0}
.mini-name{font-weight:600;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mini-det{font-size:10px;color:var(--gr)}
.badge{font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;white-space:nowrap}
.b-ok{background:var(--gl);color:var(--gd)}.b-due{background:var(--al);color:var(--am)}.b-overdue{background:var(--rl);color:var(--rd)}
.eq-search-row{display:flex;gap:8px;margin-bottom:14px;align-items:center}
.eq-search-row input{flex:1;padding:8px 12px;border:1px solid var(--br);border-radius:var(--ra);font-size:13px;outline:none;background:var(--wh)}
.eq-search-row input:focus{border-color:var(--gm)}
.eq-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:10px}
.ec{background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);padding:14px;cursor:pointer;transition:all .15s;box-shadow:var(--sh)}
.ec:hover{border-color:var(--gm);transform:translateY(-1px)}
.ec-hdr{display:flex;gap:10px;margin-bottom:10px;align-items:flex-start}
.ec-ico{width:44px;height:44px;background:var(--gl);border-radius:var(--ra);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;border:1px solid var(--gb)}
.ec-title{font-size:13px;font-weight:700;color:var(--gd);line-height:1.3}
.ec-sub{font-size:11px;color:var(--gr);margin-top:2px}
.ec-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px;margin-top:8px}
.estat{text-align:center;padding:5px;background:var(--grl);border-radius:5px}
.estat-v{font-size:12px;font-weight:700;color:var(--gd)}
.estat-l{font-size:9px;color:var(--gr);text-transform:uppercase;margin-top:1px}
.ec-foot{display:flex;justify-content:space-between;margin-top:8px;padding-top:7px;border-top:1px solid var(--br);font-size:10px;color:var(--gr)}
.detail-hdr{display:flex;align-items:flex-start;gap:14px;margin-bottom:16px;padding:14px;background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);box-shadow:var(--sh)}
.d-big-ico{width:56px;height:56px;background:var(--gl);border-radius:var(--rlg);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;border:2px solid var(--gb)}
.d-title{font-size:19px;font-weight:700;color:var(--gd)}
.d-sub{color:var(--gr);font-size:12px;margin-top:3px}
.d-actions{margin-top:9px;display:flex;gap:6px;flex-wrap:wrap}
.hrs-bar{display:flex;align-items:center;gap:9px;padding:10px 12px;background:var(--gl);border-radius:var(--ra);margin-bottom:14px;border:1px solid var(--gb);flex-wrap:wrap}
.hrs-bar label{font-size:12px;color:var(--gd);font-weight:600}
.hrs-bar input{width:85px;padding:5px 7px;border:1px solid var(--gb);border-radius:5px;font-size:13px;font-weight:600;background:var(--wh);outline:none}
.dtabs{display:flex;border-bottom:2px solid var(--br);margin-bottom:14px}
.dtab{padding:7px 14px;font-size:13px;cursor:pointer;color:var(--gr);border-bottom:2px solid transparent;margin-bottom:-2px;font-weight:500}
.dtab.active{color:var(--gd);border-bottom-color:var(--gd)}
.ilist{display:flex;flex-direction:column;gap:7px}
.iitem{background:var(--grl);border-radius:var(--ra);padding:9px 11px;display:flex;align-items:center;gap:9px;flex-wrap:wrap;border:1px solid var(--br)}
.iitem .in{flex:1;min-width:120px;font-size:13px;font-weight:600}
.iitem .ifreq{font-size:11px;color:var(--gr)}
.iitem .istat{font-size:11px;font-weight:600}
.iadd{display:flex;gap:6px;margin-top:9px;flex-wrap:wrap;padding:9px;background:var(--gl);border-radius:var(--ra);border:1px dashed var(--gb)}
.iadd input,.iadd select{padding:5px 7px;border:1px solid var(--br);border-radius:5px;font-size:12px;font-family:inherit;outline:none;background:var(--wh)}
.iadd input{flex:1;min-width:100px}
.hist-item{display:flex;gap:10px;padding:7px 0;border-bottom:1px solid var(--br);font-size:12px}
.hist-date{color:var(--gr);width:75px;flex-shrink:0;font-weight:500}
.hist-task{flex:1}
.hist-main{font-weight:600;margin-bottom:2px}
.hist-meta{color:var(--gr)}
.hist-cost{color:var(--gd);font-weight:700;width:55px;text-align:right;flex-shrink:0}
.specs-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.spec-item{padding:8px 10px;background:var(--grl);border-radius:var(--ra)}
.spec-label{font-size:9px;color:var(--gr);text-transform:uppercase;letter-spacing:.5px;font-weight:600}
.spec-val{font-size:13px;font-weight:600;margin-top:2px;color:#222}
.wo-filter-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px}
.wo-toolbar{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;margin-bottom:12px;padding:11px 13px;background:var(--gl);border:1px solid var(--gb);border-radius:var(--ra)}
.wo-toolbar label{font-size:10px;font-weight:700;color:var(--gr);text-transform:uppercase;letter-spacing:.3px;margin-bottom:3px;display:block}
.wo-toolbar input{width:100%;padding:6px 8px;border:1px solid var(--gb);border-radius:5px;font-size:13px;font-family:inherit;outline:none;background:var(--wh)}
.wo-item{background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);padding:13px;margin-bottom:10px;box-shadow:var(--sh);transition:border-color .15s}
.wo-item.sel{border-color:var(--gm);box-shadow:0 0 0 2px rgba(45,106,47,.15)}
.wo-select-wrap{display:flex;align-items:flex-start;gap:10px}
.wo-cb{width:20px;height:20px;border:2px solid var(--br);border-radius:4px;cursor:pointer;flex-shrink:0;margin-top:2px;display:flex;align-items:center;justify-content:center;transition:all .15s;background:var(--wh);font-size:13px;font-weight:700;color:#fff}
.wo-cb.on{background:var(--gd);border-color:var(--gd)}
.wo-num{font-size:10px;font-weight:700;color:var(--gr);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
.wo-title{font-size:14px;font-weight:700;color:var(--gd)}
.wo-meta{font-size:11px;color:var(--gr);margin-top:2px}
.wo-urg{font-size:11px;font-weight:700;margin-top:3px}
.chk{width:13px;height:13px;border:2px solid #ccc;border-radius:3px;cursor:pointer;flex-shrink:0;display:inline-block;transition:all .15s}
.chk.done{background:var(--gd);border-color:var(--gd)}
.wo-step{display:flex;align-items:center;gap:7px;font-size:12px;padding:3px 0;border-top:1px solid var(--br);color:#333}
.wo-step:first-child{border-top:none;padding-top:0}
.wo-actions{margin-top:9px;display:flex;gap:7px;flex-wrap:wrap}
.mgr-note-box{margin-top:9px;padding:9px;background:#fafff9;border:1px solid var(--gb);border-radius:var(--ra)}
.mgr-note-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--gd);margin-bottom:4px}
.mgr-note-box textarea{width:100%;padding:5px 7px;border:1px solid var(--gb);border-radius:5px;font-size:12px;font-family:inherit;resize:vertical;outline:none;background:var(--wh);min-height:48px}
.cal-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px}
.cal-nav{display:flex;align-items:center;gap:10px}
.cal-month{font-size:15px;font-weight:700;color:var(--gd);min-width:130px;text-align:center}
.cal-legend{display:flex;gap:10px;font-size:11px;color:var(--gr)}
.cal-legend span{display:flex;align-items:center;gap:4px}
.cal-ldot{width:10px;height:10px;border-radius:2px;display:inline-block}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--br);border:1px solid var(--br);border-radius:var(--ra);overflow:hidden}
.cal-dow{background:var(--gd);color:#fff;text-align:center;padding:6px 2px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.cal-cell{background:var(--wh);min-height:72px;padding:5px 4px}
.cal-cell.om{background:#f9fbf9}
.cal-cell.today{background:#f0faf0}
.cal-dn{font-size:10px;font-weight:700;color:var(--gr);margin-bottom:3px;text-align:right}
.today .cal-dn{color:var(--gd)}
.cal-ev{font-size:9px;padding:2px 3px;border-radius:3px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cev-ov{background:#ffcdd2;color:#b71c1c}.cev-du{background:#ffe0b2;color:#bf360c}.cev-ok{background:var(--gl);color:#1b5e20}
.bulk-card{background:var(--wh);border:1px solid var(--br);border-radius:var(--ra);padding:11px;display:flex;flex-direction:column;gap:5px;transition:border-color .15s}
.bulk-card.changed{border-color:#f59e0b;background:#fffbeb}
.bulk-ico-row{display:flex;align-items:center;gap:8px}
.bulk-ico{width:34px;height:34px;background:var(--gl);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.bulk-name{font-size:12px;font-weight:700;color:var(--gd);line-height:1.3}
.bulk-cur{font-size:10px;color:var(--gr);margin-top:1px}
.bulk-inp-row{display:flex;align-items:center;gap:6px;margin-top:3px}
.bulk-inp-row input{flex:1;padding:5px 8px;border:1px solid var(--br);border-radius:5px;font-size:14px;font-weight:700;font-family:inherit;outline:none;background:var(--wh)}
.bulk-inp-row input:focus{border-color:var(--gm)}
.bulk-unit{font-size:11px;color:var(--gr);font-weight:600;white-space:nowrap}
.bulk-delta{font-size:10px;font-weight:600;padding:2px 5px;border-radius:4px}
.bulk-delta.pos{background:var(--gl);color:var(--gd)}.bulk-delta.same{color:var(--gr)}
.bulk-alert{font-size:10px;margin-top:2px}
.bulk-alert.ov{color:var(--rd);font-weight:600}.bulk-alert.du{color:var(--am);font-weight:600}.bulk-alert.ok{color:var(--gm)}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:flex-start;justify-content:center;padding:20px;overflow-y:auto}
.modal{background:var(--wh);border-radius:var(--rlg);width:100%;max-width:640px;box-shadow:0 8px 40px rgba(0,0,0,.18)}
.modal-hdr{padding:14px 18px;border-bottom:1px solid var(--br);display:flex;align-items:center;justify-content:space-between}
.modal-hdr h2{font-size:15px;font-weight:700;color:var(--gd)}
.modal-body{padding:18px}
.modal-footer{padding:10px 18px;border-top:1px solid var(--br);display:flex;justify-content:flex-end;gap:8px}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fgrid .full{grid-column:1/-1}
.fg{display:flex;flex-direction:column;gap:3px}
.fg label{font-size:11px;font-weight:600;color:var(--gr);text-transform:uppercase;letter-spacing:.3px}
.fg input,.fg select,.fg textarea{padding:7px 9px;border:1px solid var(--br);border-radius:var(--ra);font-size:13px;font-family:inherit;outline:none;background:var(--wh)}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--gm)}
.fsec{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--gd);margin:14px 0 7px;padding-bottom:3px;border-bottom:2px solid var(--gb)}
.fsec:first-child{margin-top:0}

/* ---- REPAIR REQUESTS ---- */
.rep-layout{display:grid;grid-template-columns:minmax(300px,380px) 1fr;gap:14px;align-items:start}
.rep-form{position:sticky;top:70px}
.rep-urg{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.rep-urg button{border:2px solid var(--br);background:var(--wh);border-radius:var(--ra);padding:9px 6px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;color:var(--gr);transition:all .15s}
.rep-urg .ub-low.on{background:var(--gl);border-color:var(--gm);color:var(--gd)}
.rep-urg .ub-med.on{background:#e3f2fd;border-color:var(--bl);color:var(--bl)}
.rep-urg .ub-high.on{background:var(--al);border-color:#ef6c00;color:var(--am)}
.rep-urg .ub-crit.on{background:var(--rl);border-color:var(--rd);color:var(--rd)}
.rep-hint{font-size:11px;color:var(--gr);margin-top:4px}
.rep-filter{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.rep-filter .btn.on{background:var(--gl);color:var(--gd);border-color:var(--gm)}
.rep-card{background:var(--wh);border:1px solid var(--br);border-left-width:5px;border-radius:var(--rlg);padding:13px;margin-bottom:10px;box-shadow:var(--sh)}
.rep-card.u-low{border-left-color:var(--gm)}.rep-card.u-med{border-left-color:var(--bl)}.rep-card.u-high{border-left-color:#ef6c00}.rep-card.u-crit{border-left-color:var(--rd)}
.rep-card.is-done{opacity:.72}
.rep-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap}
.rep-eq{font-size:15px;font-weight:700;color:var(--gd)}
.rep-meta{font-size:11px;color:var(--gr);margin-top:2px}
.rep-badges{display:flex;gap:6px;flex-wrap:wrap}
.rep-desc{margin-top:9px;font-size:13px;line-height:1.5;color:#222;word-break:break-word}
.rep-done-line{margin-top:6px;font-size:11px;color:var(--gd);font-weight:600}
.rep-actions{margin-top:10px;display:flex;gap:6px;flex-wrap:wrap}
.rb-low{background:var(--gl);color:var(--gd)}.rb-med{background:#e3f2fd;color:var(--bl)}.rb-high{background:var(--al);color:var(--am)}.rb-crit{background:var(--rl);color:var(--rd)}
.rs-open{background:var(--grl);color:var(--gr)}.rs-prog{background:#fff8e1;color:#8d6e00}.rs-done{background:var(--gl);color:var(--gd)}
#nav-rep-badge{display:none}
#nav-rep-badge.show{display:inline-block;margin-left:auto}
.sidebar.collapsed #nav-rep-badge{display:none}
@media(max-width:900px){.rep-layout{grid-template-columns:1fr}.rep-form{position:static}.rep-form input,.rep-form select,.rep-form textarea{font-size:16px}}
@media(max-width:700px){#nav-rep-badge.show{display:none}}

/* ---- GROUPED WORK ORDERS ---- */
.wo-group{background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);margin-bottom:16px;box-shadow:var(--sh);overflow:hidden}
.wo-group-hdr{display:flex;align-items:flex-start;gap:12px;padding:14px;background:linear-gradient(135deg,#f0f7f0 0%,var(--wh) 100%);border-bottom:1px solid var(--br);flex-wrap:wrap}
.wo-group-ico{width:46px;height:46px;background:var(--gl);border-radius:var(--ra);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;border:1px solid var(--gb)}
.wo-group-info{flex:1;min-width:0}
.wo-group-name{font-size:16px;font-weight:700;color:var(--gd);margin-bottom:2px}
.wo-group-meta{font-size:11px;color:var(--gr);margin-top:1px}
.wo-group-right{display:flex;flex-direction:column;align-items:flex-end;gap:7px;flex-shrink:0}
.wo-group-badges{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.wo-group-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.wo-task-list{padding:0 14px 14px}
.wo-task-row{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:var(--ra);border:1px solid var(--br);margin-top:7px;background:#fafff9;transition:all .15s;cursor:pointer}
.wo-task-row:hover{border-color:var(--gm);background:var(--gl)}
.wo-task-row.sel-task{border-color:var(--gm);background:var(--gl);box-shadow:0 0 0 2px rgba(45,106,47,.12)}
.wo-task-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;width:100%}

.empty-state{text-align:center;padding:36px 20px;color:var(--gr)}
.empty-state .es-icon{font-size:38px;margin-bottom:9px}
.empty-state .es-title{font-size:14px;font-weight:600;margin-bottom:5px;color:#444}
.es-sub{font-size:12px;margin-bottom:14px}
.toast{position:fixed;bottom:20px;right:20px;background:var(--gd);color:#fff;padding:10px 16px;border-radius:var(--ra);font-size:13px;font-weight:500;z-index:999;opacity:0;transition:opacity .3s;box-shadow:0 4px 16px rgba(0,0,0,.2)}
.toast.show{opacity:1}
@media print{.sidebar,.topbar,.tabbar,.more-sheet,.more-back,.no-print,.modal-overlay,.toast{display:none!important}body,html{height:auto;overflow:visible}.app,.main{display:block;height:auto;overflow:visible}.content{padding:0}.page{display:block!important}.page:not(#page-workorders){display:none!important}#page-workorders{display:block!important}.wo-item{page-break-inside:avoid}}
@media(max-width:700px){.sb-toggle{display:none}}
@media(max-width:700px){.kpi-grid{grid-template-columns:1fr 1fr}.dash-grid{grid-template-columns:1fr}.eq-grid{grid-template-columns:1fr}.sidebar{width:56px}.s-brand,.s-tagline,.nav-label,.sidebar-bottom{display:none}.nav-item span:not(.ni){display:none}.fgrid{grid-template-columns:1fr}.fgrid .full{grid-column:1}}
/* ---- PHONE / APP LAYOUT (<=700px): bottom tab bar, compact header, sheet-style modals ---- */
.tabbar,.more-sheet,.more-back{display:none}
@media(max-width:700px){
html,body{height:auto}
body{height:auto;min-height:100vh;overflow:visible;-webkit-tap-highlight-color:transparent;-webkit-text-size-adjust:100%}
.app{height:auto;overflow:visible;display:block}
.sidebar{display:none}
.main{height:auto;min-height:100vh;overflow:visible;padding-bottom:calc(68px + env(safe-area-inset-bottom))}
.topbar{padding:calc(9px + env(safe-area-inset-top)) 14px 9px;gap:8px;background:var(--gd);border-bottom:0;flex-wrap:nowrap}
.topbar>div:first-child{min-width:0;flex:1}
.topbar-title{font-size:18px;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topbar-sub,.tb-desk{display:none!important}
.topbar>div:last-child{flex-wrap:nowrap!important;gap:6px!important;flex-shrink:0}
#api-status{font-size:0!important;width:32px;height:32px;padding:0!important;border-radius:50%!important;display:inline-flex;align-items:center;justify-content:center}
#api-status::before{content:'\25CF';font-size:16px;line-height:1;color:#78909c}
#api-status[data-s="ok"]::before{color:#2d6a2f}
#api-status[data-s="syncing"]::before{color:#e65100}
#api-status[data-s="error"]::before{color:#c62828}
.topbar .btn-secondary{background:rgba(255,255,255,.2);color:#fff;min-height:32px;padding:4px 10px}
.content{padding:12px 12px 18px}
.card{padding:14px}
.kpi-grid{gap:8px;margin-bottom:12px}.kpi{padding:12px 11px}.kpi-val{font-size:26px}
.eq-grid{grid-template-columns:1fr}
#bulk-hrs-grid,#bulk-mi-grid{grid-template-columns:minmax(0,1fr)!important}
.bulk-card{min-width:0}
.bulk-inp-row{min-width:0}
.bulk-inp-row input{min-width:0;width:100%}
.eq-grid{grid-template-columns:minmax(0,1fr)}
.cal-grid{grid-template-columns:repeat(7,minmax(0,1fr))}
.wo-toolbar{grid-template-columns:1fr!important}
.wo-filter-row{gap:8px}
.wo-filter-row div[style*="width:1px"]{display:none}
.eq-search-row{gap:8px}
.eq-search-row .btn{white-space:nowrap;padding:8px 12px}
.eq-search-row input{min-width:0}
.cal-hdr{gap:6px}
input,select,textarea{font-size:16px!important}
.btn{min-height:42px;padding:8px 14px}
.btn-sm{min-height:38px;padding:6px 12px;font-size:13px}
.btn-xs{min-height:34px;padding:4px 11px;font-size:12px}
.bulk-inp-row input{min-height:46px;font-size:18px!important}
.rep-urg button{min-height:48px;font-size:14px}
.rep-form input,.rep-form select{min-height:46px}
.cal-month{min-width:0}.cal-cell{min-height:54px;padding:3px 2px}.cal-ev{font-size:8px}
.toast{left:14px;right:14px;bottom:calc(76px + env(safe-area-inset-bottom));text-align:center}
.modal-overlay{padding:0!important;align-items:flex-end!important}
.modal{max-width:none;border-radius:18px 18px 0 0;max-height:94vh;max-height:94dvh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.modal-hdr{position:sticky;top:0;z-index:2;background:var(--wh);padding:12px 14px}
.modal-footer{position:sticky;bottom:0;z-index:2;background:var(--wh);padding:10px 14px calc(10px + env(safe-area-inset-bottom))}
.modal-body{padding:14px}
.tabbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:120;background:var(--wh);border-top:1px solid var(--br);padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -2px 10px rgba(0,0,0,.08)}
.tb-item{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:58px;padding:7px 2px 6px;border:0;background:none;font-family:inherit;font-size:10px;font-weight:600;color:var(--gr);cursor:pointer;position:relative}
.tb-ico{font-size:21px;line-height:1;opacity:.7;filter:grayscale(.5)}
.tb-item.on{color:var(--gd)}
.tb-item.on .tb-ico{opacity:1;filter:none}
.tb-item.on::before{content:'';position:absolute;top:0;left:24%;right:24%;height:3px;border-radius:0 0 3px 3px;background:var(--gd)}
.tb-badge{display:none;position:absolute;top:4px;left:calc(50% + 6px);min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:var(--rd);color:#fff;font-size:10px;font-weight:700;line-height:17px;text-align:center}
.tb-badge.show{display:block}
.more-back{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:130}
.more-back.open{display:block}
.more-sheet{display:block;position:fixed;left:0;right:0;bottom:0;z-index:140;background:var(--wh);border-radius:18px 18px 0 0;padding:8px 14px calc(14px + env(safe-area-inset-bottom));box-shadow:0 -6px 24px rgba(0,0,0,.2);transform:translateY(105%);visibility:hidden;transition:transform .22s ease,visibility 0s linear .22s}
.more-sheet.open{transform:none;visibility:visible;transition:transform .22s ease,visibility 0s}
.more-grip{width:40px;height:4px;border-radius:2px;background:var(--br);margin:4px auto 12px}
.more-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.more-btn{display:flex;align-items:center;gap:10px;min-height:58px;padding:12px;border:1px solid var(--br);border-radius:12px;background:var(--wh);font:inherit;font-size:14px;font-weight:600;color:var(--gd);text-align:left;cursor:pointer}
.more-btn:active{background:var(--gl)}
.more-btn .ni{font-size:22px}
.more-foot{margin-top:12px;text-align:center;font-size:11px;color:var(--gr);line-height:1.6}
:root{--tbh:56px}
html.navtop body{padding-top:var(--tbh)}
html.navtop .tabbar{top:0;bottom:auto;padding-bottom:0;border-top:0;border-bottom:1px solid var(--br);box-shadow:0 2px 8px rgba(0,0,0,.08)}
html.navtop .tb-item{min-height:var(--tbh)}
html.navtop .tb-item.on::before{top:auto;bottom:0;border-radius:3px 3px 0 0}
html.navtop .topbar{top:var(--tbh)}
html.navtop .main{padding-bottom:18px}
html.navtop .more-sheet{top:var(--tbh);bottom:auto;border-radius:0 0 18px 18px;padding:14px;transform:translateY(-110%);box-shadow:0 8px 24px rgba(0,0,0,.2)}
html.navtop .more-sheet.open{transform:none}
html.navtop .more-grip{display:none}
html.navtop .modal-overlay{align-items:flex-start!important}
html.navtop .modal{border-radius:0 0 18px 18px;max-height:100vh}
html.navtop .toast{bottom:auto;top:calc(var(--tbh) + 70px)}
}
/* ---- SUPPLIES & REORDERS ---- */
.sup-layout{display:grid;grid-template-columns:minmax(0,360px) minmax(0,1fr);gap:16px;align-items:start}
.sup-side,.sup-main{min-width:0}
#page-supplies .card{min-width:0}
#page-supplies .fgrid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 10px}
#page-supplies .fg{min-width:0}
#page-supplies .fg.full{grid-column:1/-1}
#page-supplies .fg input,#page-supplies .fg select,#page-supplies .fg textarea{width:100%;min-width:0}
#page-supplies .card-title{font-size:15px;margin-bottom:14px}
.sup-opt{font-weight:400;text-transform:none;letter-spacing:0;color:var(--gr)}
.sup-inline{display:grid;grid-template-columns:84px minmax(0,1fr);gap:8px}
.sup-chkl{display:flex!important;align-items:center;gap:8px;text-transform:none!important;font-size:13px!important;font-weight:500!important;color:#1a2e1a!important;cursor:pointer}
.sup-chkl input{width:18px!important;height:18px}
.sup-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.sup-det{margin-top:12px}
.sup-det summary{cursor:pointer;font-weight:600;font-size:13px;color:var(--gd);padding:4px 0}
.sup-foot{margin-top:14px;padding:0 4px}
.sup-bar2{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
#sp-count{font-size:12px;color:var(--gr);margin-left:6px}
.sup-email{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.sup-email input{flex:1;min-width:180px;padding:7px 9px;border:1px solid var(--br);border-radius:var(--ra);font-size:13px;font-family:inherit}
#sp-sync-note{font-size:11px;color:var(--gr);margin-top:14px;text-align:center}
.sup-gh{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:2px 2px 8px;margin:18px 0 8px;border-bottom:2px solid var(--gb);font-weight:700;font-size:14px;color:var(--gd)}
.sup-gh:first-child{margin-top:0}
.sup-gh small{font-weight:400;color:var(--gr);margin-left:6px}
.sup-item{background:var(--wh);border:1px solid var(--br);border-radius:var(--rlg);padding:12px 14px;margin-bottom:8px;box-shadow:var(--sh);display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}
.sup-item.st-ordered{background:#fffaf0}
.sup-item.st-picked{opacity:.6}
.sup-item.urgent{border-color:var(--rd)}
.sup-info{flex:1;min-width:180px}
.sup-title{font-size:14px;font-weight:600;color:#1a2e1a;word-break:break-word}
.sup-item.st-picked .sup-title{text-decoration:line-through}
.sup-qty{font-weight:400;color:var(--gr);margin-left:6px}
.sup-meta{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:4px;font-size:12px;color:var(--gr);align-items:center}
.sup-meta a{color:var(--bl)}
.sup-meta .bad{color:var(--rd);font-weight:700}.sup-meta .warn{color:var(--am);font-weight:700}
.sup-note{font-size:12px;color:var(--gr);font-style:italic;margin-top:4px;white-space:pre-wrap;word-break:break-word}
.sup-act{display:flex;gap:6px;align-items:center}
.sup-act select{padding:5px 7px;border:1px solid var(--br);border-radius:var(--ra);font-size:12px;font-family:inherit;background:var(--wh)}
.sup-st{display:flex;gap:8px;align-items:center;padding:9px 0;border-bottom:1px solid var(--grl)}
.sup-st:last-of-type{border-bottom:0}
.sup-st .sup-info{min-width:0}
.sup-empty{background:var(--wh);border:1px dashed var(--br);border-radius:var(--rlg);padding:28px 16px;text-align:center;color:var(--gr);font-size:13px}
@media(max-width:900px){.sup-layout{grid-template-columns:minmax(0,1fr)}.sup-main{order:-1}#page-supplies .fg input,#page-supplies .fg select,#page-supplies .fg textarea,.sup-email input{font-size:16px}}
#nav-sup-badge{display:none}
#nav-sup-badge.show{display:inline-block;margin-left:auto}
.sidebar.collapsed #nav-sup-badge{display:none}
@media(max-width:700px){#nav-sup-badge.show{display:none}}
@media print{.main{height:auto!important;overflow:visible!important;padding:0!important}.app{height:auto!important}}

.rep-photos{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}
.rep-photos img{width:82px;height:82px;object-fit:cover;border-radius:8px;border:1px solid var(--br);cursor:zoom-in;background:var(--grl)}
.ph-lb{position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.88);display:none;flex-direction:column;align-items:center;justify-content:center;padding:14px;gap:12px}
.ph-lb.open{display:flex}
.ph-lb img{max-width:100%;max-height:80vh;border-radius:8px;background:#222}
.ph-lb .lb-bar{display:flex;gap:10px;align-items:center}
.ph-lb a,.ph-lb button{color:#fff;font:inherit;font-size:14px;font-weight:600;background:rgba(255,255,255,.18);border:0;border-radius:8px;padding:9px 16px;text-decoration:none;cursor:pointer;min-height:40px;display:inline-flex;align-items:center}
/* ---- FIELD APP INSTALL CARD ---- */
.fq-card{display:flex;gap:14px;align-items:flex-start;background:linear-gradient(135deg,#e8f5e9 0%,#fff 70%);border:1px solid var(--gb);border-radius:var(--rlg);padding:14px;margin-bottom:16px;box-shadow:var(--sh)}
.fq-ico{width:58px;height:58px;border-radius:14px;flex-shrink:0;box-shadow:0 2px 6px rgba(0,0,0,.2)}
.fq-body{flex:1;min-width:0}
.fq-title{font-size:15px;font-weight:700;color:var(--gd)}
.fq-sub{font-size:12px;color:var(--gr);margin-top:2px;line-height:1.5}
.fq-btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.fq-steps{display:none;margin-top:10px;padding:10px 12px;background:var(--wh);border:1px solid var(--br);border-radius:var(--ra);font-size:12px;line-height:1.7;color:#333}
.fq-steps.open{display:block}
.fq-steps b{color:var(--gd)}
</style>
</head>
<body>
<nav class="tabbar no-print" id="tabbar" aria-label="Main">
  <button class="tb-item on" data-tb="dashboard" data-fn="navDashboard"><span class="tb-ico">&#128202;</span><span>Home</span></button>
  <button class="tb-item" data-tb="equipment" data-fn="navEquipment"><span class="tb-ico">&#128668;</span><span>Equipment</span></button>
  <button class="tb-item" data-tb="bulkhours" data-fn="navBulkhours"><span class="tb-ico">&#9203;</span><span>Hours</span></button>
  <button class="tb-item" data-tb="repairs" data-fn="navRepairs"><span class="tb-ico">&#129520;</span><span>Repairs</span><span class="tb-badge" id="tb-rep-badge">0</span></button>
  <button class="tb-item" data-tb="more" data-fn="openMore"><span class="tb-ico">&#8943;</span><span>More</span></button>
</nav>
<div class="more-back no-print" id="more-back"></div>
<div class="more-sheet no-print" id="more-sheet" role="dialog" aria-label="More">
  <div class="more-grip"></div>
  <div class="more-grid">
    <button class="more-btn" data-fn="navWorkorders"><span class="ni">&#128295;</span><span>Work Orders</span></button>
    <button class="more-btn" data-fn="navSupplies"><span class="ni">&#128722;</span><span>Supplies</span></button>
    <button class="more-btn" data-fn="navCalendar"><span class="ni">&#128197;</span><span>Calendar</span></button>
    <button class="more-btn" data-fn="openAddEquip"><span class="ni">&#10133;</span><span>Add Equipment</span></button>
    <button class="more-btn" data-fn="printSelectedWO"><span class="ni">&#128424;</span><span>Print Work Orders</span></button>
    <button class="more-btn" data-fn="forceSync"><span class="ni">&#8635;</span><span>Sync Now</span></button>
    <button class="more-btn" data-fn="openApiSetup"><span class="ni">&#9729;&#65039;</span><span>Cloud Settings</span></button>
  </div>
  <div class="more-foot">WS Lawn Care Services, LLC &#183; Titusville, FL<br>321-209-0668</div>
</div>
<div class="app">
<div class="sidebar">
  <div class="sidebar-logo">
    <button class="sb-toggle" id="sb-toggle" onclick="toggleSidebar()" title="Collapse menu">&#171;</button>
    <div class="s-brand">&#127807; WS Lawn Care</div>
    <div class="s-tagline">Equipment Maintenance Portal</div>
  </div>
  <div style="padding:8px 0">
    <div class="nav-label">Main</div>
    <div class="nav-item active" data-nav="dashboard" onclick="navDashboard()" title="Dashboard"><span class="ni">&#128202;</span> <span>Dashboard</span></div>
    <div class="nav-item" data-nav="equipment" onclick="navEquipment()" title="Equipment"><span class="ni">&#128668;</span> <span>Equipment</span></div>
    <div class="nav-item" data-nav="workorders" onclick="navWorkorders()" title="Work Orders"><span class="ni">&#128295;</span> <span>Work Orders</span></div>
    <div class="nav-item" data-nav="calendar" onclick="navCalendar()" title="Calendar"><span class="ni">&#128197;</span> <span>Calendar</span></div>
    <div class="nav-item" data-nav="bulkhours" onclick="navBulkhours()" title="Update Hours"><span class="ni">&#9203;</span> <span>Update Hours</span></div>
    <div class="nav-item" data-nav="repairs" onclick="navRepairs()" title="Repair Requests"><span class="ni">&#129520;</span> <span>Repair Requests</span><span class="badge b-overdue" id="nav-rep-badge">0</span></div>
    <div class="nav-item" data-nav="supplies" onclick="navSupplies()" title="Supplies & Reorders"><span class="ni">&#128722;</span> <span>Supplies</span><span class="badge b-overdue" id="nav-sup-badge">0</span></div>
    <div class="nav-label" style="margin-top:8px">Quick Actions</div>
    <div class="nav-item" onclick="openAddEquip()" title="Add Equipment"><span class="ni">&#10133;</span> <span>Add Equipment</span></div>
    <div class="nav-item" onclick="printSelectedWO()" title="Print Work Orders"><span class="ni">&#128424;</span> <span>Print Work Orders</span></div>
  </div>
  <div class="sidebar-bottom">WS Lawn Care Services, LLC<br>Titusville, FL - Brevard County<br>321-209-0668<br>"Jesus First Before Profits"</div>
</div>

<div class="main">
  <div class="topbar">
    <div><div class="topbar-title" id="ptitle">Dashboard</div><div class="topbar-sub">WS Lawn Care Services - Equipment Maintenance Portal &nbsp;&#183;&nbsp; Google Sheets Sync Active</div></div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap" class="no-print">
      <span id="api-status" style="font-size:11px;padding:3px 9px;border-radius:12px;font-weight:500;background:#eceff1;color:#546e7a">&#9679; Loading...</span>
      <button class="btn btn-secondary btn-sm" onclick="forceSync()" title="Refresh from Google Sheets">&#8635; Sync</button>
      <button class="btn btn-secondary btn-sm tb-desk" onclick="navWorkorders()">&#128295; Work Orders</button>
      <button class="btn btn-primary btn-sm tb-desk" onclick="openAddEquip()">&#10133; Add Equipment</button>
    </div>
  </div>

  <div class="content">

    <!-- DASHBOARD -->
    <div class="page active" id="page-dashboard">
      <div id="api-setup-notice" style="display:none;background:#fff3e0;border:1px solid #ffcc80;border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:13px">
        <b style="color:#e65100">&#9888; Setup Required:</b> To share data across devices, paste your Google Apps Script URL into the portal.
        <button class="btn btn-amber btn-sm" style="margin-left:10px" onclick="openApiSetup()">Configure Now</button>
      </div>
      <div class="fq-card no-print" id="fq-card">
        <img class="fq-ico" src="icon-192.png" alt="WS Quick">
        <div class="fq-body">
          <div class="fq-title">&#9889; WS Quick - Field App</div>
          <div class="fq-sub">For crew in the field: report a repair or add a supply item in seconds. No login, works with no signal, and everything shows up here for the office to review and edit.</div>
          <div class="fq-btns">
            <button class="btn btn-primary btn-sm" onclick="fqOpen()">Open Field App</button>
            <button class="btn btn-secondary btn-sm" onclick="fqCopy()">Copy Link</button>
            <button class="btn btn-secondary btn-sm" onclick="fqText()">Text Link to Crew</button>
            <button class="btn btn-secondary btn-sm" onclick="fqSteps()">How to install</button>
          </div>
          <div class="fq-steps" id="fq-steps">
            <b>First time on a phone (30 seconds):</b><br>
            1. Open the link on the crew member's phone (use <b>Text Link to Crew</b>).<br>
            2. <b>Android / Chrome:</b> tap the <b>Install</b> button at the top of the app, or menu (&#8942;) &rarr; <b>Install app</b>.<br>
            &nbsp;&nbsp;&nbsp;<b>iPhone / Safari:</b> tap <b>Share</b> &rarr; <b>Add to Home Screen</b>.<br>
            3. Open the <b>WS Quick</b> lightning bolt icon on the home screen. Their name is remembered after the first entry.<br>
            <span style="color:var(--gr)">Tip: open it from a browser, not from inside Wix, so the install option appears.</span>
          </div>
        </div>
      </div>
      <div class="kpi-grid">
        <div class="kpi kpi-g"><div class="kpi-label">Total Equipment</div><div class="kpi-val" id="k-total">0</div><div class="kpi-sub">pieces tracked</div></div>
        <div class="kpi kpi-r"><div class="kpi-label">Overdue Service</div><div class="kpi-val" id="k-ov">0</div><div class="kpi-sub">needs attention now</div></div>
        <div class="kpi kpi-a"><div class="kpi-label">Due This Month</div><div class="kpi-val" id="k-du">0</div><div class="kpi-sub">coming up soon</div></div>
        <div class="kpi kpi-b"><div class="kpi-label">Open Work Orders</div><div class="kpi-val" id="k-wo">0</div><div class="kpi-sub">tasks pending</div></div>
      </div>
      <div class="dash-grid">
        <div class="card"><div class="card-title">&#9888;&#65039; Priority Alerts <span>sorted by urgency</span></div><div id="d-alerts"></div></div>
        <div class="card"><div class="card-title">&#128668; Fleet Status <button class="btn btn-secondary btn-xs no-print" onclick="navEquipment()">View All</button></div><div id="d-equip"></div></div>
        <div class="card"><div class="card-title">&#128203; Recent Activity</div><div id="d-activity"></div></div>
        <div class="card"><div class="card-title">&#128197; Due Within 7 Days</div><div id="d-week"></div></div>
      </div>
    </div>

    <!-- EQUIPMENT -->
    <div class="page" id="page-equipment">
      <div class="eq-search-row">
        <input id="eq-search" placeholder="Search by name, type, or make..." oninput="renderEqList()">
        <button class="btn btn-primary no-print" onclick="openAddEquip()">&#10133; Add Equipment</button>
      </div>
      <div id="eq-count" style="font-size:12px;color:var(--gr);margin-bottom:10px"></div>
      <div class="eq-grid" id="eq-grid"></div>
    </div>

    <!-- DETAIL -->
    <div class="page" id="page-detail">
      <div style="margin-bottom:12px" class="no-print"><button class="btn btn-secondary btn-sm" onclick="navEquipment()">&#8592; Back to Equipment</button></div>
      <div class="detail-hdr">
        <div class="d-big-ico" id="d-icon">&#128668;</div>
        <div style="flex:1;min-width:0">
          <div class="d-title" id="d-name">-</div>
          <div class="d-sub" id="d-sub">-</div>
          <div class="d-actions no-print">
            <button class="btn btn-secondary btn-sm" onclick="openEditEquip()">&#9999;&#65039; Edit</button>
            <button class="btn btn-danger btn-sm" onclick="delEquip()">&#128465;&#65039; Delete</button>
            <button class="btn btn-primary btn-sm" onclick="openLogSvc()">&#10133; Log Service</button>
            <button class="btn btn-amber btn-sm" onclick="printSelectedWO()">&#128424;&#65039; Print WOs</button>
          </div>
        </div>
      </div>
      <div class="hrs-bar no-print">
        <label>Hours:</label><input type="number" id="u-hrs" min="0"> <button class="btn btn-primary btn-sm" onclick="updHrs()">Save</button>
        <div style="width:1px;height:18px;background:var(--gb);margin:0 4px"></div>
        <label>Miles:</label><input type="number" id="u-mi" min="0"> <button class="btn btn-primary btn-sm" onclick="updMi()">Save</button>
      </div>
      <div class="dtabs no-print">
        <div class="dtab active" onclick="dTabIntervals(this)">&#128295; Intervals</div>
        <div class="dtab" onclick="dTabHistory(this)">&#128203; Service History</div>
        <div class="dtab" onclick="dTabSpecs(this)">&#128208; Specs &amp; Cost</div>
      </div>
      <div id="dt-intervals"></div>
      <div id="dt-history" style="display:none"></div>
      <div id="dt-specs" style="display:none"></div>
    </div>

    <!-- WORK ORDERS -->
    <div class="page" id="page-workorders">
      <div class="no-print">
        <div class="wo-filter-row">
          <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            <button class="btn btn-secondary btn-sm" id="wf-all" onclick="setWFAll(this)">All Outstanding</button>
            <button class="btn btn-secondary btn-sm" id="wf-ov" onclick="setWFOverdue(this)">&#128308; Overdue</button>
            <button class="btn btn-secondary btn-sm" id="wf-du" onclick="setWFDue(this)">&#128993; Due Soon</button>
            <div style="width:1px;height:18px;background:var(--br);margin:0 2px"></div>
            <button class="btn btn-secondary btn-sm" onclick="selAllTrue()">&#9745; Select All</button>
            <button class="btn btn-secondary btn-sm" onclick="selAllFalse()">&#9744; Deselect All</button>
          </div>
          <div style="display:flex;gap:8px;align-items:center">
            <span id="sel-count" style="font-size:12px;color:var(--gr)">None selected</span>
            <button class="btn btn-primary btn-sm" onclick="printSelectedWO()">&#128424;&#65039; Print Selected</button>
          </div>
        </div>
        <div class="wo-toolbar">
          <div><label>Assigned Tech</label><input id="wo-tech" placeholder="Willie, William, Sandra..."></div>
          <div><label>Work Order Date</label><input id="wo-date" type="date"></div>
          <div><label>Priority Instructions for Tech</label><input id="wo-instr" placeholder="e.g. Focus on mowers first..."></div>
        </div>
      </div>
      <div id="wo-count" style="font-size:12px;color:var(--gr);margin-bottom:10px"></div>
      <div id="wo-list"></div>
    </div>

    <!-- REPAIR REQUESTS -->
    <div class="page" id="page-repairs">
      <div class="rep-layout">
        <div class="card rep-form">
          <div class="card-title">&#128221; New Repair Request <span>crew: fill this out</span></div>
          <div class="fgrid">
            <div class="fg"><label>Tech Name *</label><input id="rp-tech" list="rp-tech-list" placeholder="Your name" autocomplete="off"><datalist id="rp-tech-list"><option value="Willie"><option value="William"><option value="Sandra"></datalist></div>
            <div class="fg"><label>Date *</label><input id="rp-date" type="date"></div>
            <div class="fg full"><label>Equipment *</label><select id="rp-equip"></select></div>
            <div class="fg full"><label>Urgency of Repair *</label>
              <div class="rep-urg" id="rp-urg">
                <button type="button" class="ub-low" data-urg="Low">Low</button>
                <button type="button" class="ub-med on" data-urg="Medium">Medium</button>
                <button type="button" class="ub-high" data-urg="High">High</button>
                <button type="button" class="ub-crit" data-urg="Critical">Critical</button>
              </div>
              <div class="rep-hint" id="rp-urg-hint"></div>
            </div>
            <div class="fg full"><label>Description of Repair Needed *</label><textarea id="rp-desc" rows="4" maxlength="1000" placeholder="What is wrong? What did you notice? Any noise, leak, or damage?"></textarea></div>
          </div>
          <button class="btn btn-primary" style="margin-top:12px;width:100%;justify-content:center;padding:10px" onclick="submitRepair()">&#10004; Submit Repair Request</button>
        </div>
        <div>
          <div class="rep-filter" id="rep-filter">
            <button class="btn btn-secondary btn-sm on" data-rfilter="open">Open</button>
            <button class="btn btn-secondary btn-sm" data-rfilter="done">Completed</button>
            <button class="btn btn-secondary btn-sm" data-rfilter="all">All</button>
            <span id="rep-count" style="font-size:12px;color:var(--gr);margin-left:6px"></span>
            <button class="btn btn-secondary btn-sm no-print" style="margin-left:auto" onclick="repRefresh()">&#8635; Refresh</button>
          </div>
          <div id="rep-sync-note" style="font-size:11px;margin-bottom:10px;color:var(--gr)"></div>
          <div id="rep-list"></div>
        </div>
      </div>
    </div>

    <!-- SUPPLIES & REORDERS -->
    <div class="page" id="page-supplies">
      <div class="sup-layout">
        <div class="sup-side">
          <div class="card">
            <div class="card-title"><span id="sp-form-title">Add to list</span></div>
            <div class="fgrid">
              <div class="fg full"><label>Item</label><input id="sp-name" placeholder="e.g. String trimmer line, mix fuel" autocomplete="off"></div>
              <div class="fg"><label>Qty</label><input id="sp-qty" type="number" inputmode="decimal" step="any" value="1"></div>
              <div class="fg"><label>Unit</label><input id="sp-unit" list="sp-unit-list" placeholder="gal, box..." autocomplete="off"></div>
              <div class="fg"><label>Store</label><input id="sp-store" list="sp-store-list" placeholder="Home Depot" autocomplete="off"></div>
              <div class="fg"><label>How</label><select id="sp-method"><option value="pickup">Pick up</option><option value="order">Order online</option></select></div>
              <div class="fg full"><label>Pick up / order by</label><input id="sp-due" type="date"></div>
              <div class="fg full"><label>Repeat every <span class="sup-opt">(optional)</span></label>
                <div class="sup-inline"><input id="sp-rep" type="number" min="0" step="1" placeholder="0"><select id="sp-repu"><option value="days">days</option><option value="weeks">weeks</option><option value="months" selected>months</option></select></div></div>
            </div>
            <details class="sup-det"><summary>More details</summary>
              <div class="fgrid" style="margin-top:10px">
                <div class="fg full"><label>Pickup spot / branch</label><input id="sp-loc" placeholder="e.g. Pro Desk" autocomplete="off"></div>
                <div class="fg full"><label>Order link</label><input id="sp-url" placeholder="https://amazon.com/..." autocomplete="off"></div>
                <div class="fg full"><label>Order #</label><input id="sp-order" autocomplete="off"></div>
                <div class="fg full"><label>Notes</label><textarea id="sp-notes" rows="2"></textarea></div>
                <div class="fg full"><label class="sup-chkl"><input type="checkbox" id="sp-urgent"> &#128293; Mark urgent</label></div>
              </div>
            </details>
            <div class="sup-row" style="margin-top:14px">
              <button class="btn btn-primary" id="sp-submit" style="flex:1;justify-content:center" data-sact="submit">Add to list</button>
              <button class="btn btn-secondary" id="sp-cancel" style="display:none" data-sact="cancel">Cancel</button>
            </div>
            <datalist id="sp-store-list"></datalist>
            <datalist id="sp-unit-list"><option value="ea"><option value="box"><option value="gal"><option value="qt"><option value="bag"><option value="roll"><option value="spool"><option value="case"><option value="pack"></datalist>
          </div>

          <div class="card" style="margin-top:14px">
            <div class="card-title"><span>Repeat orders</span></div>
            <div id="sp-staples"></div>
            <details class="sup-det" id="sp-st-det"><summary id="sp-st-sum">+ New repeat order</summary>
              <div class="fgrid" style="margin-top:10px">
                <div class="fg full"><label>Item</label><input id="spt-name" placeholder="e.g. 2-cycle mix fuel" autocomplete="off"></div>
                <div class="fg"><label>Qty</label><input id="spt-qty" type="number" inputmode="decimal" step="any" value="1"></div>
                <div class="fg"><label>Unit</label><input id="spt-unit" list="sp-unit-list" autocomplete="off"></div>
                <div class="fg"><label>Store</label><input id="spt-store" list="sp-store-list" autocomplete="off"></div>
                <div class="fg"><label>How</label><select id="spt-method"><option value="pickup">Pick up</option><option value="order">Order online</option></select></div>
                <div class="fg full"><label>Order link</label><input id="spt-url" placeholder="https://amazon.com/..." autocomplete="off"></div>
                <div class="fg full"><label>Remind me every</label>
                  <div class="sup-inline"><input id="spt-rep" type="number" min="0" step="1" placeholder="1"><select id="spt-repu"><option value="days">days</option><option value="weeks">weeks</option><option value="months" selected>months</option></select></div></div>
                <div class="fg full"><label>Next reminder <span class="sup-opt">(blank = from today)</span></label><input id="spt-next" type="date"></div>
              </div>
              <div class="sup-row" style="margin-top:12px">
                <button class="btn btn-primary btn-sm" id="spt-submit" data-sact="st-submit">Save</button>
                <button class="btn btn-secondary btn-sm" id="spt-cancel" style="display:none" data-sact="st-cancel">Cancel</button>
                <button class="btn btn-danger btn-sm" id="spt-del" style="display:none;margin-left:auto" data-sact="st-del">Delete</button>
              </div>
            </details>
          </div>

          <details class="sup-det sup-foot"><summary>Stores &amp; backup</summary>
            <div style="font-size:12px;color:var(--gr);margin:8px 0">Add a store address to get a map link on each item.</div>
            <div id="sp-stores"></div>
            <div class="sup-row" style="margin-top:6px">
              <button class="btn btn-secondary btn-sm" data-sact="addstore">+ Add store</button>
              <button class="btn btn-secondary btn-sm" data-sact="export">Download backup</button>
              <label class="btn btn-secondary btn-sm" style="cursor:pointer">Restore backup<input type="file" id="sp-import" accept=".json,application/json" style="display:none"></label>
            </div>
          </details>
        </div>

        <div class="sup-main">
          <div class="sup-bar2">
            <div class="rep-filter" id="sp-filter" style="margin:0">
              <button class="btn btn-secondary btn-sm on" data-sact="filter" data-id="open">To get</button>
              <button class="btn btn-secondary btn-sm" data-sact="filter" data-id="picked">Done</button>
              <span id="sp-count"></span>
            </div>
            <div class="sup-row no-print">
              <button class="btn btn-secondary btn-sm" data-sact="print">Print</button>
              <button class="btn btn-secondary btn-sm" data-sact="copy">Copy</button>
              <button class="btn btn-secondary btn-sm" data-sact="emailtoggle">Email</button>
              <button class="btn btn-secondary btn-sm" id="sp-clear" style="display:none" data-sact="clearpicked">Clear done</button>
            </div>
          </div>
          <div class="sup-email no-print" id="sp-email-row" style="display:none">
            <input id="sp-email" placeholder="Email address(es), comma separated" autocomplete="off">
            <button class="btn btn-primary btn-sm" data-sact="email-gmail">Gmail</button>
            <button class="btn btn-secondary btn-sm" data-sact="email-mailto">Mail app</button>
          </div>
          <div id="sp-list"></div>
          <div id="sp-sync-note"></div>
        </div>
      </div>
    </div>

    <!-- CALENDAR -->
    <div class="page" id="page-calendar">
      <div class="cal-hdr">
        <div class="cal-nav">
          <button class="btn btn-secondary btn-sm" onclick="chMo(-1)">&#9664; Prev</button>
          <div class="cal-month" id="cal-label">June 2026</div>
          <button class="btn btn-secondary btn-sm" onclick="chMo(1)">Next &#9654;</button>
        </div>
        <div class="cal-legend">
          <span><span class="cal-ldot" style="background:#ffcdd2"></span>Overdue</span>
          <span><span class="cal-ldot" style="background:#ffe0b2"></span>Due Soon</span>
          <span><span class="cal-ldot" style="background:var(--gl)"></span>Scheduled</span>
        </div>
      </div>
      <div class="cal-grid" id="cal-grid"></div>
      <div style="margin-top:12px;padding:10px 12px;background:var(--gl);border:1px solid var(--gb);border-radius:var(--ra);font-size:12px;color:var(--gr)"><b style="color:var(--gd)">Tip:</b> Only time-based intervals (monthly, quarterly, annual) appear on the calendar. Hour-based tasks appear in Work Orders.</div>
    </div>

    <!-- BULK HOURS -->
    <div class="page" id="page-bulkhours">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px">
        <div style="font-size:13px;color:var(--gr)">Enter current readings for all equipment. Recommended: every Monday morning. Changes highlight yellow until saved.</div>
        <div style="display:flex;gap:8px">
          <button class="btn btn-secondary btn-sm" onclick="bulkReset()">&#8617; Reset</button>
          <button class="btn btn-primary" onclick="bulkSave()">&#128190; Save All Updates</button>
        </div>
      </div>
      <div class="card" style="margin-bottom:14px">
        <div class="card-title">&#9203; Engine Hours <span>mowers, trimmers, chainsaws, blowers, pressure washer</span></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:9px" id="bulk-hrs-grid"></div>
      </div>
      <div class="card" style="margin-bottom:14px">
        <div class="card-title">&#128664; Vehicle Mileage <span>Ford F250</span></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:9px" id="bulk-mi-grid"></div>
      </div>
      <div class="card">
        <div class="card-title">&#128276; Maintenance Status After Save <span>live preview as you type</span></div>
        <div id="bulk-preview"></div>
      </div>
    </div>

  </div>
</div>
</div>

<!-- MODAL: API SETUP -->
<div class="modal-overlay" id="m-api" style="display:none">
<div class="modal">
  <div class="modal-hdr"><h2>&#9729;&#65039; Connect to Google Sheets</h2><button class="btn btn-secondary btn-sm" onclick="closeMApi()">&#10005; Close</button></div>
  <div class="modal-body">
    <div style="background:#e8f5e9;border:1px solid #c8e6c9;border-radius:8px;padding:12px 14px;font-size:12px;margin-bottom:14px;line-height:1.7">
      <b style="color:#2d6a2f">Steps to connect:</b><br>
      1. Open your Google Spreadsheet<br>
      2. Click <b>Extensions &rarr; Apps Script</b><br>
      3. Paste the Apps Script code (download below)<br>
      4. Click <b>Deploy &rarr; New Deployment &rarr; Web App</b><br>
      5. Set <b>Who has access</b> to <b>Anyone</b><br>
      6. Click Deploy &rarr; copy the Web App URL<br>
      7. Paste the URL below and click Save
    </div>
    <div class="fg">
      <label>Google Apps Script Web App URL</label>
      <input id="api-url-input" type="url" placeholder="https://script.google.com/macros/s/YOUR_ID/exec" style="font-size:12px">
    </div>
    <div style="margin-top:10px;font-size:12px;color:var(--gr)">
      Once connected, all data syncs to your Google Sheet automatically. Any device with the portal URL will see the same live data.
    </div>
    <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn btn-secondary btn-sm" onclick="testApiConnection()">&#128269; Test Connection</button>
      <span id="api-test-result" style="font-size:12px;padding:5px 0;color:var(--gr)"></span>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-secondary" onclick="closeMApi()">Cancel</button>
    <button class="btn btn-primary" onclick="saveApiUrl()">&#128190; Save &amp; Connect</button>
  </div>
</div>
</div>

<!-- MODAL: ADD/EDIT EQUIPMENT -->
<div class="modal-overlay" id="m-equip" style="display:none">
<div class="modal">
  <div class="modal-hdr"><h2 id="m-equip-title">Add Equipment</h2><button class="btn btn-secondary btn-sm" onclick="closeMEquip()">&#10005; Close</button></div>
  <div class="modal-body">
    <input type="hidden" id="edit-id">
    <div class="fsec">Equipment Information</div>
    <div class="fgrid">
      <div class="fg full"><label>Equipment Name *</label><input id="f-name" placeholder="e.g. Toro Grandstand #1"></div>
      <div class="fg"><label>Type</label><select id="f-type"><option>Stand-On Mower</option><option>Walk-Behind Mower</option><option>Zero-Turn Mower</option><option>Push Mower</option><option>Trimmer / Edger</option><option>Blower</option><option>Chainsaw</option><option>Pole Saw</option><option>Pressure Washer</option><option>Truck</option><option>Enclosed Trailer</option><option>Dump Trailer</option><option>Climbing Gear</option><option>Attachments / Other</option></select></div>
      <div class="fg"><label>Make</label><input id="f-make" placeholder="Toro, Stihl, Ford..."></div>
      <div class="fg"><label>Model</label><input id="f-model"></div>
      <div class="fg"><label>Serial / VIN</label><input id="f-serial"></div>
      <div class="fg"><label>Year</label><input id="f-year" type="number"></div>
      <div class="fg"><label>Current Hours</label><input id="f-hrs" type="number" value="0" min="0"></div>
      <div class="fg"><label>Current Miles</label><input id="f-mi" type="number" value="0" min="0"></div>
      <div class="fg"><label>Date In Service</label><input id="f-pdate" type="date"></div>
      <div class="fg"><label>Purchase Cost ($)</label><input id="f-cost" type="number" min="0"></div>
      <div class="fg"><label>Est. Annual Hours</label><input id="f-annhrs" type="number" min="0"></div>
      <div class="fg"><label>Cost / Hour ($)</label><input id="f-cph" type="number" step="0.01" min="0"></div>
      <div class="fg full"><label>Notes</label><textarea id="f-notes" rows="2"></textarea></div>
    </div>
    <div class="fsec">Maintenance Intervals</div>
    <div id="edit-int-list" style="margin-bottom:8px"></div>
    <div class="iadd">
      <input id="ii-task" placeholder="Task (e.g. Oil Change)">
      <input id="ii-freq" type="number" placeholder="Every" style="width:65px;flex:none" min="1">
      <select id="ii-unit" style="width:85px;flex:none"><option value="hours">Hours</option><option value="miles">Miles</option><option value="days">Days</option><option value="months">Months</option><option value="years">Years</option></select>
      <button class="btn btn-primary btn-sm" onclick="addII()" style="flex:none">Add</button>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-secondary" onclick="closeMEquip()">Cancel</button>
    <button class="btn btn-primary" onclick="saveEquip()">&#128190; Save Equipment</button>
  </div>
</div>
</div>

<!-- MODAL: LOG SERVICE -->
<div class="modal-overlay" id="m-svc" style="display:none">
<div class="modal">
  <div class="modal-hdr"><h2>Log Service / Maintenance</h2><button class="btn btn-secondary btn-sm" onclick="closeMSvc()">&#10005; Close</button></div>
  <div class="modal-body">
    <div class="fgrid">
      <div class="fg"><label>Date *</label><input id="sv-date" type="date"></div>
      <div class="fg"><label>Performed By</label><input id="sv-by" placeholder="Willie, William, Sandra..."></div>
      <div class="fg full"><label>Task *</label><input id="sv-task" placeholder="Oil change, blade sharpening..."></div>
      <div class="fg"><label>Hours at Service</label><input id="sv-hrs" type="number" min="0"></div>
      <div class="fg"><label>Miles at Service</label><input id="sv-mi" type="number" min="0"></div>
      <div class="fg"><label>Parts Cost ($)</label><input id="sv-cost" type="number" step="0.01" min="0"></div>
      <div class="fg"><label>Labor Cost ($)</label><input id="sv-labor" type="number" step="0.01" min="0"></div>
      <div class="fg full"><label>Notes</label><textarea id="sv-notes" rows="2"></textarea></div>
      <div class="fg full"><label>Mark Interval Complete</label><select id="sv-int"><option value="">- select if applicable -</option></select></div>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-secondary" onclick="closeMSvc()">Cancel</button>
    <button class="btn btn-primary" onclick="saveSvc()">&#10004; Log Service</button>
  </div>
</div>
</div>

