   intervals:[{id:'i21a',task:'Attachment Blades Inspect/Sharpen',freq:25,unit:'hours',lastDone:null,lastHours:0},{id:'i21b',task:'Connection Points Grease',freq:50,unit:'hours',lastDone:null,lastHours:0},{id:'i21c',task:'Annual Attachment Inventory',freq:1,unit:'years',lastDone:null}]}
];

/* ── API CONFIG ─────────────────────────────────────────────
   Paste your Apps Script Web App URL below after deploying.
   Leave blank to use localStorage (offline mode).
────────────────────────────────────────────────────────── */
var API_URL = 'https://script.google.com/macros/s/AKfycbw2nRqb1O0W1Q_GjcfaPRkDyKPKbst5H74mFPqM4sRjEsjSzdNSryGk-VLJtVS3LMxE/exec';

var API_READY = false;
var SYNC_PENDING = false;
var SYNC_TIMER = null;

/* All API calls use GET to avoid CORS preflight.
   Data is JSON-encoded and passed as a URL parameter. */
function apiGet(params, callback) {
  if (!API_URL) { if (callback) callback(null); return; }
  var url = API_URL + '?action=' + params.action;
  if (params.id)   url += '&id='   + encodeURIComponent(params.id);
  if (params.data) url += '&data=' + encodeURIComponent(JSON.stringify(params.data));
  fetch(url, {method: 'GET', redirect: 'follow'})
    .then(function(r) { return r.json(); })
    .then(function(d) { if (callback) callback(d); })
    .catch(function(err) { console.warn('API error:', err); if (callback) callback(null); });
}

/* Alias - all writes also go through GET */
function apiPost(body, callback) {
  if (!API_URL) { if (callback) callback(null); return; }
  var action = body.action;
  /* Map old POST actions to new GET actions */
  var getAction = action;
  if (action === 'saveAllEquipment') getAction = 'saveAll';
  if (action === 'saveEquipment')    getAction = 'saveOne';
  if (action === 'logActivity')      getAction = 'logActivity';
  if (action === 'logService')       getAction = 'logService';
  if (action === 'deleteEquipment')  getAction = 'deleteEquip';
  var params = { action: getAction };
  if (body.data) params.data = body.data;
  if (body.id)   params.id   = body.id;
  apiGet(params, callback);
}

function setApiStatus(status, msg) {
  var el = document.getElementById('api-status');
  if (!el) return;
  if (status === 'ok')      { el.style.background='#e8f5e9'; el.style.color='#2d6a2f'; el.textContent='☁ ' + (msg||'Synced'); }
  else if (status === 'syncing') { el.style.background='#fff3e0'; el.style.color='#e65100'; el.textContent='↻ ' + (msg||'Syncing...'); }
  else if (status === 'local')   { el.style.background='#eceff1'; el.style.color='#546e7a'; el.textContent='⚠ Offline mode (localStorage only)'; }
  else if (status === 'error')   { el.style.background='#ffebee'; el.style.color='#c62828'; el.textContent='✗ ' + (msg||'Sync error'); }
  el.setAttribute('data-s', status); el.title = el.textContent;
}

var FRESH_LOCAL = false;
function load() {
  /* Always load from localStorage first so the UI is instant */
  try { var d = localStorage.getItem(SK); if(d) S = JSON.parse(d); } catch(e) {}
  if (!S.equipment || !S.equipment.length) {
    S.equipment = JSON.parse(JSON.stringify(FLEET));
    S.activity  = [];
    FRESH_LOCAL = true;   /* these are only starter defaults, NOT edits - the sheet must win */
  }
  if (!S.activity) S.activity = [];

  /* Then sync with Google Sheets */
  if (API_URL) {
    setApiStatus('syncing', 'Connecting to Google Sheets...');
    bootstrapSheets();
  } else {
    setApiStatus('local');
  }
}

function save() {
  /* Always save to localStorage immediately */
  try { localStorage.setItem(SK, JSON.stringify(S)); } catch(e) {}
  if (!API_URL) return;
  /* Debounce — avoid hammering API on rapid changes */
  if (SYNC_TIMER) clearTimeout(SYNC_TIMER);
  SYNC_PENDING = true;
  setApiStatus('syncing', 'Saving...');
  SYNC_TIMER = setTimeout(function() { syncToSheets(); }, 1500);
}

/* Save one equipment record (e.g. after logging a service) */
function saveOne(eq) {
  try { localStorage.setItem(SK, JSON.stringify(S)); } catch(e) {}
  if (!API_URL) return;
  setApiStatus('syncing', 'Saving ' + eq.name + '...');
  var _s = sig(eq);
  apiGet({action:'saveOne', data: slimEq(eq)}, function(result) {
    if (result && result.ok) {
      BASE[eq.id] = _s; saveBase();
      setApiStatus('ok', eq.name + ' saved ' + new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}));
    } else {
      setApiStatus('error', 'Save failed for ' + eq.name);
    }
  });
}

/* ---- RELIABLE SYNC (v7) -----------------------------------
   BASE tracks what Google Sheets has confirmed for each piece.
   Only changed pieces are sent, one at a time. Failed saves retry
   automatically and are never overwritten by stale sheet data.
   DEL_Q holds deletes that still need to reach the sheet.
---------------------------------------------------------------- */
var BASE_KEY='ws_synced_v1', BASE={};
var DEL_KEY='ws_pending_del_v1', DEL_Q=[];
var SYNC_BUSY=false, SYNC_AGAIN=false;
try{BASE=JSON.parse(localStorage.getItem(BASE_KEY)||'{}');}catch(e){BASE={};}
try{DEL_Q=JSON.parse(localStorage.getItem(DEL_KEY)||'[]');}catch(e){DEL_Q=[];}
function sig(e){var o=slimEq(e);delete o.updatedAt;return JSON.stringify(o);}
function saveBase(){try{localStorage.setItem(BASE_KEY,JSON.stringify(BASE));}catch(e){}}
function saveDelQ(){try{localStorage.setItem(DEL_KEY,JSON.stringify(DEL_Q));}catch(e){}}
function dirtyEq(){return S.equipment.filter(function(e){return BASE[e.id]!==sig(e);});}
function queueDelete(id){if(DEL_Q.indexOf(id)<0)DEL_Q.push(id);saveDelQ();delete BASE[id];saveBase();}
function nowTime(){return new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});}

function syncToSheets() {
  if (!API_URL) return;
  if (SYNC_BUSY) { SYNC_AGAIN = true; return; }
  var tasks = DEL_Q.map(function(id){return {del:id};})
    .concat(dirtyEq().map(function(eq){return {eq:eq, s:sig(eq)};}));
  if (!tasks.length) { setApiStatus('ok', 'All saved'); return; }
  SYNC_BUSY = true;
  (function next(i, fail) {
    if (i >= tasks.length) {
      SYNC_BUSY = false;
      if (fail) {
        setApiStatus('error', fail + ' not saved - retrying in 30s');
        setTimeout(syncToSheets, 30000);
      } else {
        setApiStatus('ok', 'Saved ' + nowTime());
      }
      if (SYNC_AGAIN) { SYNC_AGAIN = false; syncToSheets(); }
      return;
    }
    var t = tasks[i];
    setApiStatus('syncing', 'Saving ' + (i + 1) + ' of ' + tasks.length + '...');
    if (t.del) {
      apiGet({action:'deleteEquip', id:t.del}, function(r) {
        if (r && (r.ok || (r.error && String(r.error).indexOf('Not found') === 0))) {
          DEL_Q = DEL_Q.filter(function(x){return x !== t.del;}); saveDelQ();
          next(i + 1, fail);
        } else next(i + 1, fail + 1);
      });
    } else {
      apiGet({action:'saveOne', data: slimEq(t.eq)}, function(r) {
        if (r && r.ok) { BASE[t.eq.id] = t.s; saveBase(); next(i + 1, fail); }
        else next(i + 1, fail + 1);
      });
    }
  })(0, 0);
}

/* Merge sheet data into local without overwriting unsaved local edits */
function mergeFromSheet(data) {
  var dirty = {};
  /* A browser with no saved data starts from the built-in default fleet (hours 0).
     If the sheet already has equipment, those defaults must NOT be treated as unsaved
     edits, or they overwrite the real hours/miles on the sheet. */
  var sheetHasData = (data.equipment || []).length > 0;
  if (!(FRESH_LOCAL && sheetHasData)) {
    dirtyEq().forEach(function(e){dirty[e.id] = e;});
  }
  FRESH_LOCAL = false;
  var out = [];
  (data.equipment || []).forEach(function(e) {
    if (DEL_Q.indexOf(e.id) >= 0) return;      /* deleted here, delete still pending */
    BASE[e.id] = sig(e);
    out.push(dirty[e.id] || e);
  });
  Object.keys(dirty).forEach(function(id) {   /* local-only pieces not on the sheet yet */
    if (!out.some(function(e){return e.id === id;})) out.push(dirty[id]);
  });
  S.equipment = out;
  S.activity = data.activity || S.activity || [];
  saveBase();
  try { localStorage.setItem(SK, JSON.stringify(S)); } catch(e) {}
}
function afterMerge(msg) {
  if (dirtyEq().length || DEL_Q.length) syncToSheets();
  else setApiStatus('ok', msg + ' ' + nowTime());
}

/* Sync equipment in chunks of 5 to balance URL size vs request count.
   5 records ~ 6KB encoded — well within the ~8KB URL limit.
   21 pieces = 5 requests instead of 21 individual calls. */
var CHUNK_SIZE = 5;

function slimEq(eq) {
  /* Strip history (logged in MAINT_ServiceLog) and null interval fields */
  var out = {};
  var keys = Object.keys(eq);
  for (var k = 0; k < keys.length; k++) {
    if (keys[k] === 'history') { out.history = []; continue; }
    out[keys[k]] = eq[keys[k]];
  }
  return out;
}

function syncSequential(arr, chunkStart, failCount, done) {
  if (chunkStart >= arr.length) {
    if (done) done(arr.length - failCount, failCount);
    return;
  }
  var chunk = [];
  for (var i = chunkStart; i < arr.length && i < chunkStart + CHUNK_SIZE; i++) {
    chunk.push(slimEq(arr[i]));
  }
  var chunkEnd = chunkStart + chunk.length;
  setApiStatus('syncing', 'Saving ' + (chunkStart + 1) + '-' + chunkEnd + ' of ' + arr.length + '...');
  apiGet({action:'saveChunk', data: chunk}, function(result) {
    var failed = (!result || !result.ok) ? chunk.length : 0;
    setTimeout(function() {
      syncSequential(arr, chunkEnd, failCount + failed, done);
    }, 500);
  });
}

function logAct(eq, act) {
  S.activity.push({equip:eq, action:act, date:new Date().toLocaleDateString('en-US')});
  if (S.activity.length > 60) S.activity = S.activity.slice(-60);
  /* Log to activity sheet */
  if (API_URL) {
    apiPost({action:'logActivity', data:{equip:eq, action:act, date:new Date().toLocaleDateString('en-US')}}, null);
  }
}
function ge(id){for(var i=0;i<S.equipment.length;i++){if(S.equipment[i].id===id)return S.equipment[i];}return null;}
function gid(){return 'id'+Date.now()+Math.floor(Math.random()*1000);}
function td(){return new Date().toISOString().split('T')[0];}
function toast(msg,dur){dur=dur||2500;var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show');},dur);}
/* logAct is defined above with API sync */

var TI={'Stand':'&#9889;','Walk':'&#128668;','Zero':'&#127919;','Push':'&#128099;','Trim':'&#9986;','Blow':'&#128168;','Chain':'&#129178;','Pole':'&#127794;','Press':'&#128167;','Truck':'&#128666;','Encl':'&#128230;','Dump':'&#128667;','Climb':'&#129495;','Attach':'&#128295;','Other':'&#128295;'};
function eico(e){var keys=Object.keys(TI);for(var i=0;i<keys.length;i++){if(e.type&&e.type.indexOf(keys[i])===0)return TI[keys[i]];}return '&#128295;';}

function iStat(e,i){
  var now=new Date();
  if(i.unit==='hours'){var due=(i.lastHours||0)+i.freq,rem=due-(e.hours||0);if(rem<=0)return{s:'overdue',lbl:Math.abs(Math.round(rem))+'hrs overdue'};if(rem<=i.freq*.2)return{s:'due',lbl:Math.round(rem)+'hrs left'};return{s:'ok',lbl:Math.round(rem)+'hrs left'};}
  if(i.unit==='miles'){var due2=(i.lastMiles||0)+i.freq,rem2=due2-(e.miles||0);if(rem2<=0)return{s:'overdue',lbl:Math.abs(rem2).toLocaleString()+'mi overdue'};if(rem2<=i.freq*.2)return{s:'due',lbl:rem2.toLocaleString()+'mi left'};return{s:'ok',lbl:rem2.toLocaleString()+'mi left'};}
  var ld=i.lastDone?new Date(i.lastDone):new Date(e.purchaseDate||'2024-01-01');var dd=new Date(ld);
  if(i.unit==='days')dd.setDate(dd.getDate()+i.freq);
  else if(i.unit==='months')dd.setMonth(dd.getMonth()+i.freq);
  else if(i.unit==='years')dd.setFullYear(dd.getFullYear()+i.freq);
  var diff=Math.round((dd-now)/864e5);
  if(diff<0)return{s:'overdue',lbl:Math.abs(diff)+'d overdue',dd:dd};
  if(diff<=30)return{s:'due',lbl:'Due in '+diff+'d',dd:dd};
  return{s:'ok',lbl:'Due '+dd.toLocaleDateString('en-US',{month:'short',day:'numeric'}),dd:dd};}

function eStatus(e){if(!e.intervals||!e.intervals.length)return 'ok';var ss=e.intervals.map(function(i){return iStat(e,i).s;});if(ss.indexOf('overdue')>=0)return 'overdue';if(ss.indexOf('due')>=0)return 'due';return 'ok';}

function nav(id,el){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  document.getElementById('page-'+id).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});
  /* Highlight by name, not by position, so extra sidebar items (Cloud Settings) cannot shift it */
  var navTarget=document.querySelector('.nav-item[data-nav="'+(id==='detail'?'equipment':id)+'"]');
  if(navTarget)navTarget.classList.add('active');
  if(window.tbSync)tbSync(id);
  var t={dashboard:'Dashboard',equipment:'Equipment ('+S.equipment.length+')',detail:'Equipment Detail',workorders:'Work Orders',calendar:'Maintenance Calendar',bulkhours:'Update Hours & Miles',repairs:'Repair Requests',supplies:'Supplies & Reorders'};
  document.getElementById('ptitle').textContent=t[id]||id;
  if(id==='dashboard')renderDash();
  if(id==='equipment')renderEqList();
  if(id==='workorders')renderWO();
  if(id==='calendar')renderCal();
  if(id==='bulkhours')renderBulk();if(id==='repairs')renderRepairs();if(id==='supplies')renderSupplies();}

function renderDash(){
  wfClear();
  var ov=S.equipment.filter(function(e){return eStatus(e)==='overdue';}).length;
  var du=S.equipment.filter(function(e){return eStatus(e)==='due';}).length;
  var wo=0;S.equipment.forEach(function(e){(e.intervals||[]).forEach(function(i){if(iStat(e,i).s!=='ok')wo++;});});
  document.getElementById('k-total').textContent=S.equipment.length;
  document.getElementById('k-ov').textContent=ov;
  document.getElementById('k-du').textContent=du;
  document.getElementById('k-wo').textContent=wo;
  var alerts=[];
  S.equipment.forEach(function(e){(e.intervals||[]).forEach(function(i){var r=iStat(e,i);if(r.s!=='ok')alerts.push({s:r.s,lbl:r.lbl,en:e.name,task:i.task,eid:e.id});});});
  alerts.sort(function(a,b){return a.s==='overdue'?-1:1;});
  var ae=document.getElementById('d-alerts');
  if(!alerts.length){ae.innerHTML='<div class="alert-item a-ok"><div class="alert-dot dot-g"></div><div>All maintenance up to date</div></div>';return;}
  var h='';alerts.slice(0,8).forEach(function(a){var _wk=wfReg(function(){openDetail(a.eid);});h+='<div class="alert-item a-'+a.s+'" onclick="WF('+_wk+')">';h+='<div class="alert-dot dot-'+(a.s==='overdue'?'r':'a')+'"></div>';h+='<div><div style="font-weight:600;font-size:12px">'+a.task+'</div><div style="font-size:10px;color:var(--gr)">'+a.en+' - '+a.lbl+'</div></div></div>';});
  ae.innerHTML=h;
  var eqh='';S.equipment.forEach(function(e){var st=eStatus(e);var _wk=wfReg(function(){openDetail(e.id);});eqh+='<div class="eq-mini" onclick="WF('+_wk+')">';eqh+='<div class="mini-ico">'+eico(e)+'</div>';eqh+='<div class="mini-info"><div class="mini-name">'+e.name+'</div><div class="mini-det">'+e.type+' - '+(e.hours||0)+'hrs'+(e.miles?' / '+e.miles.toLocaleString()+'mi':'')+'</div></div>';eqh+='<span class="badge b-'+st+'">'+(st==='ok'?'OK':st==='due'?'Due':'OVR')+'</span></div>';});
  document.getElementById('d-equip').innerHTML=eqh;
  var act=[].concat(S.activity).reverse().slice(0,6);
  var ach=act.length?act.map(function(a){return '<div style="font-size:11px;padding:5px 0;border-bottom:1px solid var(--br);color:var(--gr)"><b style="color:var(--gd)">'+a.equip+'</b> - '+a.action+'<span style="float:right">'+a.date+'</span></div>';}).join(''):'<div style="color:var(--gr);font-size:12px">No activity yet.</div>';
  document.getElementById('d-activity').innerHTML=ach;
  var now=new Date(),wk=new Date();wk.setDate(wk.getDate()+7);var uph='';
  S.equipment.forEach(function(e){(e.intervals||[]).forEach(function(i){var r=iStat(e,i);if(r.dd&&r.dd>=now&&r.dd<=wk){var _wkd=wfReg(function(){openDetail(e.id);});uph+='<div class="alert-item a-du" onclick="WF('+_wkd+')"><div class="alert-dot dot-a"></div><div><div style="font-weight:600;font-size:12px">'+i.task+'</div><div style="font-size:10px;color:var(--gr)">'+e.name+' - '+r.lbl+'</div></div></div>';}});});
  document.getElementById('d-week').innerHTML=uph||'<div style="color:var(--gr);font-size:12px">Nothing due this week.</div>';}

function renderEqList(){
  wfClear();
  var q=(document.getElementById('eq-search')||{}).value||'';
  var eq=S.equipment.filter(function(e){return !q||e.name.toLowerCase().indexOf(q.toLowerCase())>=0||(e.make||'').toLowerCase().indexOf(q.toLowerCase())>=0||(e.type||'').toLowerCase().indexOf(q.toLowerCase())>=0;});
  document.getElementById('eq-count').textContent='Showing '+eq.length+' of '+S.equipment.length+' pieces';
  var g=document.getElementById('eq-grid');
  if(!eq.length){g.innerHTML='<div class="empty-state" style="grid-column:1/-1"><div class="es-icon">&#128269;</div><div class="es-title">No equipment found</div></div>';return;}
  var h='';eq.forEach(function(e){var st=eStatus(e);var oc=(e.intervals||[]).filter(function(i){return iStat(e,i).s==='overdue';}).length;var dc=(e.intervals||[]).filter(function(i){return iStat(e,i).s==='due';}).length;var _wk=wfReg(function(){openDetail(e.id);});h+='<div class="ec" onclick="WF('+_wk+')">';h+='<div class="ec-hdr"><div class="ec-ico">'+eico(e)+'</div><div style="flex:1;min-width:0">';h+='<div class="ec-title">'+e.name+'</div><div class="ec-sub">'+(e.make||'')+' '+(e.model||'')+(e.year?' - '+e.year:'')+'</div>';h+='<div style="margin-top:4px"><span class="badge b-'+st+'">'+(st==='ok'?'Good':st==='due'?dc+' Due':oc+' Overdue')+'</span></div></div></div>';h+='<div class="ec-stats"><div class="estat"><div class="estat-v">'+(e.hours||0).toLocaleString()+'</div><div class="estat-l">Hours</div></div>';h+='<div class="estat"><div class="estat-v">'+(e.cph?'$'+e.cph.toFixed(2):'-')+'</div><div class="estat-l">$/hr</div></div>';h+='<div class="estat"><div class="estat-v">'+((e.intervals||[]).length)+'</div><div class="estat-l">Intervals</div></div></div>';h+='<div class="ec-foot"><span>S/N: '+(e.serial||'-')+'</span><span>'+(e.purchaseDate||'')+'</span></div></div>';});
  g.innerHTML=h;}

function openDetail(id){CID=id;var e=ge(id);if(!e)return;
  document.getElementById('d-name').textContent=e.name;
  document.getElementById('d-sub').textContent=e.type+' - '+(e.make||'')+' '+(e.model||'')+' - '+(e.year||'')+' - $'+(e.cph?e.cph.toFixed(2):'?')+'/hr';
  document.getElementById('d-icon').innerHTML=eico(e);
  document.getElementById('u-hrs').value=e.hours||0;document.getElementById('u-mi').value=e.miles||0;
  dTab('intervals',document.querySelector('.dtab'));nav('detail',null);renderDI();renderDH();renderDS();}

function dTab(t,el){document.querySelectorAll('.dtab').forEach(function(x){x.classList.remove('active');});if(el)el.classList.add('active');document.getElementById('dt-intervals').style.display=t==='intervals'?'':'none';document.getElementById('dt-history').style.display=t==='history'?'':'none';document.getElementById('dt-specs').style.display=t==='specs'?'':'none';}

function renderDI(){wfClear();var e=ge(CID);if(!e)return;var el=document.getElementById('dt-intervals');if(!e.intervals||!e.intervals.length){el.innerHTML='<div style="color:var(--gr);font-size:12px;padding:10px 0">No intervals set. Edit to add.</div>';return;}
  var col={overdue:'var(--rd)',due:'#ef6c00',ok:'var(--gd)'};var h='<div class="ilist">';
  e.intervals.forEach(function(i){var r=iStat(e,i);h+='<div class="iitem"><span style="font-size:18px">'+(r.s==='overdue'?'&#128308;':r.s==='due'?'&#128993;':'&#9989;')+'</span><div class="in">'+i.task+'</div><div class="ifreq">Every '+i.freq+' '+i.unit+'</div><div class="istat" style="color:'+col[r.s]+'">'+r.lbl+'</div>';h+='<button class="btn btn-primary btn-xs no-print" onclick="qDone(\''+i.id+'\')">Done</button>';h+='<button class="btn btn-danger btn-xs no-print" onclick="delInt(\''+i.id+'\')">&#10005;</button></div>';});
  h+='</div><div style="font-size:11px;font-weight:700;color:var(--gd);margin:12px 0 5px">Add Interval</div>';h+='<div class="iadd"><input id="d-ii-task" placeholder="Task name"><input id="d-ii-freq" type="number" placeholder="Every" style="width:60px;flex:none" min="1"><select id="d-ii-unit" style="width:80px;flex:none"><option value="hours">Hours</option><option value="miles">Miles</option><option value="days">Days</option><option value="months">Months</option><option value="years">Years</option></select><button class="btn btn-primary btn-sm no-print" onclick="addIntDirect()">Add</button></div>';
  el.innerHTML=h;}

function qDone(iid){var e=ge(CID);if(!e)return;var i=null;for(var x=0;x<e.intervals.length;x++){if(e.intervals[x].id===iid){i=e.intervals[x];break;}}if(!i)return;i.lastDone=td();i.lastHours=e.hours||0;i.lastMiles=e.miles||0;i.lastDate=td();logAct(e.name,'Completed: '+i.task);save();renderDI();toast('Marked complete: '+i.task);}
function delInt(iid){if(!confirm('Remove this interval?'))return;var e=ge(CID);if(!e)return;e.intervals=e.intervals.filter(function(x){return x.id!==iid;});save();renderDI();}
function addIntDirect(){var e=ge(CID);if(!e)return;var t=document.getElementById('d-ii-task').value.trim();var f=parseInt(document.getElementById('d-ii-freq').value);var u=document.getElementById('d-ii-unit').value;if(!t||!f){alert('Enter task and frequency.');return;}if(!e.intervals)e.intervals=[];e.intervals.push({id:gid(),task:t,freq:f,unit:u,lastDone:null,lastHours:0});save();renderDI();document.getElementById('d-ii-task').value='';document.getElementById('d-ii-freq').value='';toast('Interval added');}

function renderDH(){var e=ge(CID);if(!e)return;var h=[].concat(e.history||[]).reverse();var el=document.getElementById('dt-history');var tot=h.reduce(function(s,x){return s+(x.cost||0)+(x.labor||0);},0);var out='';if(h.length)out='<div style="font-size:11px;color:var(--gr);margin-bottom:8px;padding:7px;background:var(--gl);border-radius:var(--ra)">Total tracked: <b style="color:var(--gd)">$'+tot.toFixed(2)+'</b></div>';if(h.length){h.forEach(function(x){out+='<div class="hist-item"><div class="hist-date">'+x.date+'</div><div class="hist-task"><div class="hist-main">'+x.task+'</div><div class="hist-meta">'+(x.by?'By '+x.by+' - ':'')+(x.hAtSvc||0)+'hrs'+(x.notes?' - '+x.notes:'')+'</div></div><div class="hist-cost">$'+((x.cost||0)+(x.labor||0)).toFixed(2)+'</div></div>';});}else{out='<div style="color:var(--gr);font-size:12px;padding:10px 0">No service history yet.</div>';}el.innerHTML=out;}

function renderDS(){var e=ge(CID);if(!e)return;var rows=[['Purchase Cost',e.cost?'$'+Number(e.cost).toLocaleString():'-'],['Cost / Hour',e.cph?'$'+e.cph.toFixed(2)+'/hr':'-'],['Annual Hours',e.annualHrs?e.annualHrs+' hrs/yr':'-'],['Annual Cost',e.annualHrs&&e.cph?'$'+(e.annualHrs*e.cph).toFixed(0)+'/yr':'-'],['Make',e.make||'-'],['Model',e.model||'-'],['Year',e.year||'-'],['Serial/VIN',e.serial||'-'],['In Service',e.purchaseDate||'-'],['Current Hours',(e.hours||0).toLocaleString()+' hrs'],['Current Miles',(e.miles||0).toLocaleString()+' mi'],['Type',e.type||'-'],['Notes',e.notes||'-']];var h='<div class="specs-grid">';rows.forEach(function(r){h+='<div class="spec-item"><div class="spec-label">'+r[0]+'</div><div class="spec-val">'+r[1]+'</div></div>';});h+='</div>';document.getElementById('dt-specs').innerHTML=h;}

function updHrs(){var e=ge(CID);if(!e)return;e.hours=parseFloat(document.getElementById('u-hrs').value)||0;logAct(e.name,'Hours: '+e.hours);save();renderDI();toast('Hours updated');}
function updMi(){var e=ge(CID);if(!e)return;e.miles=parseFloat(document.getElementById('u-mi').value)||0;logAct(e.name,'Miles: '+e.miles);save();renderDI();toast('Miles updated');}

function openAddEquip(){EI=[];document.getElementById('m-equip-title').textContent='Add New Equipment';document.getElementById('edit-id').value='';['f-name','f-make','f-model','f-serial','f-year','f-hrs','f-mi','f-cost','f-annhrs','f-cph','f-notes'].forEach(function(id){var el=document.getElementById(id);if(el)el.value='';});document.getElementById('f-hrs').value='0';document.getElementById('f-mi').value='0';document.getElementById('f-pdate').value=td();renderEIList();document.getElementById('m-equip').style.display='flex';}
function openEditEquip(){var e=ge(CID);if(!e)return;EI=JSON.parse(JSON.stringify(e.intervals||[]));document.getElementById('m-equip-title').textContent='Edit: '+e.name;document.getElementById('edit-id').value=e.id;document.getElementById('f-name').value=e.name||'';document.getElementById('f-type').value=e.type||'Attachments / Other';document.getElementById('f-make').value=e.make||'';document.getElementById('f-model').value=e.model||'';document.getElementById('f-serial').value=e.serial||'';document.getElementById('f-year').value=e.year||'';document.getElementById('f-hrs').value=e.hours||0;document.getElementById('f-mi').value=e.miles||0;document.getElementById('f-pdate').value=e.purchaseDate||'';document.getElementById('f-cost').value=e.cost||0;document.getElementById('f-annhrs').value=e.annualHrs||0;document.getElementById('f-cph').value=e.cph||0;document.getElementById('f-notes').value=e.notes||'';renderEIList();document.getElementById('m-equip').style.display='flex';}

function renderEIList(){var h=EI.length?'<div class="ilist">'+EI.map(function(i,x){return '<div class="iitem"><div class="in">'+i.task+'</div><div class="ifreq">Every '+i.freq+' '+i.unit+'</div><button class="btn btn-danger btn-xs" onclick="WF('+wfReg(function(){var _xi=x;EI.splice(_xi,1);renderEIList();})+')">&#10005;</button></div>';}).join('')+'</div>':'<div style="color:var(--gr);font-size:12px;padding:5px 0">No intervals yet.</div>';document.getElementById('edit-int-list').innerHTML=h;}
function addII(){var t=document.getElementById('ii-task').value.trim();var f=parseInt(document.getElementById('ii-freq').value);var u=document.getElementById('ii-unit').value;if(!t||!f){alert('Enter task and frequency.');return;}EI.push({id:gid(),task:t,freq:f,unit:u,lastDone:null,lastHours:0});document.getElementById('ii-task').value='';document.getElementById('ii-freq').value='';renderEIList();}
function saveEquip(){var name=document.getElementById('f-name').value.trim();if(!name){alert('Name required.');return;}var eid=document.getElementById('edit-id').value;var data={name:name,type:document.getElementById('f-type').value,make:document.getElementById('f-make').value,model:document.getElementById('f-model').value,serial:document.getElementById('f-serial').value,year:document.getElementById('f-year').value,hours:parseFloat(document.getElementById('f-hrs').value)||0,miles:parseFloat(document.getElementById('f-mi').value)||0,purchaseDate:document.getElementById('f-pdate').value,cost:parseFloat(document.getElementById('f-cost').value)||0,annualHrs:parseFloat(document.getElementById('f-annhrs').value)||0,cph:parseFloat(document.getElementById('f-cph').value)||0,notes:document.getElementById('f-notes').value,intervals:EI};if(eid){var e=ge(eid);Object.keys(data).forEach(function(k){e[k]=data[k];});logAct(name,'Updated');}else{var ne=JSON.parse(JSON.stringify(data));ne.id=gid();ne.history=[];S.equipment.push(ne);logAct(name,'Added');}save();closeM('m-equip');toast(name+' saved');if(eid)openDetail(eid);else{nav('equipment',document.querySelectorAll('.nav-item')[1]);renderEqList();}}
function delEquip(){var e=ge(CID);if(!e)return;if(!confirm('Delete "'+e.name+'" and all history?'))return;var _did=CID;S.equipment=S.equipment.filter(function(x){return x.id!==_did;});queueDelete(_did);save();toast('Deleted');nav('equipment',document.querySelectorAll('.nav-item')[1]);renderEqList();}

function openLogSvc(){var e=ge(CID);if(!e)return;document.getElementById('sv-date').value=td();document.getElementById('sv-by').value='';document.getElementById('sv-task').value='';document.getElementById('sv-hrs').value=e.hours||0;document.getElementById('sv-mi').value=e.miles||0;document.getElementById('sv-cost').value='';document.getElementById('sv-labor').value='';document.getElementById('sv-notes').value='';var sel=document.getElementById('sv-int');sel.innerHTML='<option value="">- select if applicable -</option>';(e.intervals||[]).forEach(function(i){sel.innerHTML+='<option value="'+i.id+'">'+i.task+' (every '+i.freq+' '+i.unit+')</option>';});document.getElementById('m-svc').style.display='flex';}
function saveSvc(){var e=ge(CID);if(!e)return;var task=document.getElementById('sv-task').value.trim();if(!task){alert('Task required.');return;}var rec={id:gid(),date:document.getElementById('sv-date').value,task:task,by:document.getElementById('sv-by').value,hAtSvc:parseFloat(document.getElementById('sv-hrs').value)||0,miAtSvc:parseFloat(document.getElementById('sv-mi').value)||0,cost:parseFloat(document.getElementById('sv-cost').value)||0,labor:parseFloat(document.getElementById('sv-labor').value)||0,notes:document.getElementById('sv-notes').value};if(!e.history)e.history=[];e.history.push(rec);var si=document.getElementById('sv-int').value;if(si){for(var x=0;x<e.intervals.length;x++){if(e.intervals[x].id===si){e.intervals[x].lastDone=rec.date;e.intervals[x].lastHours=rec.hAtSvc;e.intervals[x].lastMiles=rec.miAtSvc;e.intervals[x].lastDate=rec.date;break;}}}logAct(e.name,'Service: '+task);save();closeM('m-svc');toast('Service logged');renderDH();renderDI();}

function setWF(f,el){WF_FILTER=f;['wf-all','wf-ov','wf-du'].forEach(function(id){var b=document.getElementById(id);if(b){b.style.background='';b.style.color='';}});el.style.background='var(--gl)';el.style.color='var(--gd)';WO_SEL={};renderWO();}
function getWOGroups(){var groups=[];S.equipment.forEach(function(e){var tasks=[];(e.intervals||[]).forEach(function(i){var r=iStat(e,i);if(WF_FILTER==='overdue'&&r.s!=='overdue')return;if(WF_FILTER==='due'&&r.s==='ok')return;if(WF_FILTER==='all'&&r.s==='ok')return;tasks.push({i:i,r:r,key:e.id+'-'+i.id});});if(tasks.length){tasks.sort(function(a,b){return a.r.s==='overdue'?-1:1;});var hasOv=tasks.some(function(t){return t.r.s==='overdue';});groups.push({e:e,tasks:tasks,status:hasOv?'overdue':'due'});}});groups.sort(function(a,b){return a.status==='overdue'?-1:1;});return groups;}
function getWOItems(){var items=[];getWOGroups().forEach(function(g){g.tasks.forEach(function(t){items.push({e:g.e,i:t.i,r:t.r,key:t.key});});});return items;}
function renderWO(){
  wfClear();
  var groups=getWOGroups();var totalTasks=0;groups.forEach(function(g){totalTasks+=g.tasks.length;});
  document.getElementById('wo-count').textContent=groups.length+' equipment group'+(groups.length!==1?'s':'')+', '+totalTasks+' task'+(totalTasks!==1?'s':'')+' - check tasks to select for printing';
  var el=document.getElementById('wo-list');
  if(!groups.length){el.innerHTML='<div class="empty-state"><div class="es-icon">&#9989;</div><div class="es-title">No outstanding work orders</div></div>';updateSelCount();return;}
  var woNum=0;var h='';
  groups.forEach(function(g){
    var e=g.e;
    var ovCount=g.tasks.filter(function(t){return t.r.s==='overdue';}).length;
    var duCount=g.tasks.filter(function(t){return t.r.s==='due';}).length;
    var allSel=g.tasks.every(function(t){return !!WO_SEL[t.key];});
    var grpNoteKey='grp-'+e.id;
    h+='<div class="wo-group" id="grp-'+e.id+'">';
    h+='<div class="wo-group-hdr">';
    h+='<div class="wo-group-ico">'+eico(e)+'</div>';
    h+='<div class="wo-group-info"><div class="wo-group-name">'+e.name+'</div>';
    h+='<div class="wo-group-meta">'+e.type+' &#183; '+(e.make||'')+' '+(e.model||'')+' &#183; S/N: '+(e.serial||'-')+'</div>';
    h+='<div class="wo-group-meta">Current: '+(e.hours||0)+'hrs'+(e.miles?' / '+e.miles.toLocaleString()+'mi':'')+' &#183; $'+(e.cph?e.cph.toFixed(2):'-')+'/hr</div></div>';
    h+='<div class="wo-group-right">';
    h+='<div class="wo-group-badges">';
    if(ovCount)h+='<span class="badge b-overdue">&#128308; '+ovCount+' Overdue</span> ';
    if(duCount)h+='<span class="badge b-due">&#128993; '+duCount+' Due</span>';
    h+='</div>';
    h+='<div class="wo-group-actions no-print">';
    (function(){var _eid=e.id,_v=!allSel;var _wk=wfReg(function(){selGroup(_eid,_v);});h+='<button class="btn btn-secondary btn-sm" onclick="WF('+_wk+')">&#9745; '+(allSel?'Deselect All':'Select All')+'</button> ';})();
    (function(){var _eid=e.id;var _wk=wfReg(function(){CID=_eid;openLogSvc();});h+='<button class="btn btn-primary btn-sm" onclick="WF('+_wk+')">&#10004; Log Service</button> ';})();
    (function(){var _eid=e.id;var _wk=wfReg(function(){openDetail(_eid);});h+='<button class="btn btn-secondary btn-sm" onclick="WF('+_wk+')">View</button>';})();
    h+='</div></div></div>';
    h+='<div class="mgr-note-box no-print" style="margin:0 14px 10px 14px">';
    h+='<div class="mgr-note-lbl">&#128203; Manager Notes for Tech - '+e.name+'</div>';
    h+='<textarea id="mn-'+e.id+'" data-key="'+grpNoteKey+'" oninput="handleMgrNote(this)" placeholder="e.g. Use Mobil 10W-30, note mower timer hours, check belt tension...">'+(WO_NOTES[grpNoteKey]||'')+'</textarea>';
    h+='</div>';
    h+='<div class="wo-task-list">';
    g.tasks.forEach(function(t){
      var i=t.i,r=t.r,key=t.key;woNum++;
      var sel=!!WO_SEL[key];
      h+='<div class="wo-task-row'+(sel?' sel-task':'')+'" id="woi-'+key+'">';
      (function(){var _k=key;var _wk=wfReg(function(){toggleWO(_k);});h+='<div class="wo-cb'+(sel?' on':'')+'" onclick="WF('+_wk+')">'+(sel?'&#10003;':'')+'</div>';})();
      h+='<div style="flex:1;min-width:0">';
      h+='<div class="wo-task-top">';
      h+='<div><div class="wo-num">#'+String(woNum).padStart(3,'0')+' &nbsp;&#183;&nbsp; Every '+i.freq+' '+i.unit+'</div>';
      h+='<div class="wo-title" style="font-size:13px">'+i.task+'</div>';
      h+='<div class="wo-urg" style="color:'+(r.s==='overdue'?'var(--rd)':'#ef6c00')+'">'+r.lbl+'</div></div>';
      h+='<span class="badge b-'+(r.s==='overdue'?'overdue':'due')+'">'+(r.s==='overdue'?'OVERDUE':'Due')+'</span>';
      h+='</div></div></div>';
    });
    h+='</div></div>';
  });
  el.innerHTML=h;
  var dateEl=document.getElementById('wo-date');if(dateEl&&!dateEl.value)dateEl.value=td();
  updateSelCount();}
function toggleWO(key){if(WO_SEL[key]){delete WO_SEL[key];}else{WO_SEL[key]=true;}var row=document.getElementById('woi-'+key);if(row){var on=!!WO_SEL[key];row.classList.toggle('sel-task',on);var cb=row.querySelector('.wo-cb');if(cb){cb.classList.toggle('on',on);cb.innerHTML=on?'&#10003;':'';}};updateSelCount();}
function selGroup(eid,selectVal){var g=null;getWOGroups().forEach(function(gr){if(gr.e.id===eid)g=gr;});if(!g)return;g.tasks.forEach(function(t){if(selectVal)WO_SEL[t.key]=true;else delete WO_SEL[t.key];});renderWO();}
function selAll(v){var items=getWOItems();items.forEach(function(item){if(v)WO_SEL[item.key]=true;else delete WO_SEL[item.key];});renderWO();}
function updateSelCount(){var n=Object.keys(WO_SEL).length;var el=document.getElementById('sel-count');if(el){el.textContent=n===0?'None selected':n+' selected';el.style.color=n>0?'var(--gd)':'var(--gr)';el.style.fontWeight=n>0?'700':'400';}}

function printSelectedWO(){
  var items=[];var allItems=getWOItems();
  var selKeys=Object.keys(WO_SEL);
  if(selKeys.length===0){alert('No work orders selected.\n\nCheck the boxes next to the items you want to print, then click Print Selected.');return;}
  allItems.forEach(function(item){if(WO_SEL[item.key])items.push(item);});
  items.sort(function(a,b){return a.r.s==='overdue'?-1:1;});
  var tech=(document.getElementById('wo-tech')||{}).value||'';
  var woDate=(document.getElementById('wo-date')||{}).value||td();
  var instr=(document.getElementById('wo-instr')||{}).value||'';
  var dateStr=new Date(woDate+'T12:00:00').toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  var css='*{box-sizing:border-box;margin:0;padding:0}body{font-family:Arial,sans-serif;padding:22px;max-width:820px;margin:0 auto;color:#1a1a1a;font-size:13px}.phdr{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #2d6a2f;padding-bottom:12px;margin-bottom:18px}.coname{font-size:20px;font-weight:700;color:#2d6a2f}.cosub{font-size:11px;color:#555;margin-top:3px;line-height:1.6}.coinfo{font-size:11px;text-align:right;color:#555;line-height:1.8}.sumbar{background:#f0f7f0;border:1px solid #c8e6c9;border-radius:7px;padding:10px 13px;margin-bottom:16px;font-size:12px;display:flex;gap:20px;flex-wrap:wrap}.sumbar b{color:#2d6a2f}.wo{border:1px solid #bbb;border-radius:8px;padding:15px;margin-bottom:18px;page-break-inside:avoid}.wo-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:9px;gap:10px}.wo-n{font-size:10px;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}.wo-t{font-size:15px;font-weight:700;color:#2d6a2f;margin-bottom:3px}.wo-m{font-size:11px;color:#555;line-height:1.7}.badge{padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;white-space:nowrap;text-align:center}.bov{background:#ffebee;color:#c62828}.bdu{background:#fff3e0;color:#e65100}.mgr{background:#fffde7;border-left:3px solid #f59e0b;padding:7px 9px;border-radius:4px;margin:9px 0;font-size:11px}.mgr b{color:#92400e;font-size:10px;text-transform:uppercase;display:block;margin-bottom:2px}table{width:100%;border-collapse:collapse;font-size:12px;margin-top:9px}th{background:#f0f7f0;padding:5px 7px;text-align:left;border:1px solid #ddd;font-size:10px;text-transform:uppercase}td{padding:6px 7px;border:1px solid #ddd;vertical-align:top}.ret{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px;padding:9px;background:#f9fafb;border:1px solid #ddd;border-radius:6px}.retf{border-bottom:1px solid #999;padding-bottom:2px}.retl{font-size:9px;color:#888;text-transform:uppercase;letter-spacing:.4px;margin-bottom:7px}.notes-sec{margin-top:12px;border:1px solid #ddd;border-radius:6px;overflow:hidden}.notes-hdr{background:#f5f5f5;padding:6px 10px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:#444;display:flex;gap:0}.notes-hdr span{flex:1;padding:0 5px}.notes-hdr span:first-child{border-right:1px solid #ddd}.notes-body{display:grid;grid-template-columns:1fr 1fr}.notes-col{padding:9px}.notes-col:first-child{border-right:1px solid #ddd}.nclbl{font-size:10px;font-weight:700;text-transform:uppercase;color:#2d6a2f;margin-bottom:5px}.nline{border-bottom:1px solid #ddd;height:21px;margin-bottom:5px}.nfine{font-size:9px;color:#aaa;margin-top:3px}.sign{display:flex;gap:16px;margin-top:10px;font-size:11px;color:#555;padding-top:8px;border-top:1px dashed #ddd}.sign span{flex:1;border-bottom:1px solid #999;padding-bottom:2px}.footer{margin-top:26px;text-align:center;font-size:10px;color:#999;border-top:1px solid #eee;padding-top:10px;line-height:2}.eq-hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:2px solid #c8e6c9}.eq-name{font-size:17px;font-weight:700;color:#2d6a2f;margin-bottom:3px}';
  /* Group selected items by equipment */
  var printGroups=[];
  var seenEq={};
  items.forEach(function(item){
    var eid=item.e.id;
    if(!seenEq[eid]){seenEq[eid]=true;printGroups.push({e:item.e,tasks:[]});}
    printGroups[printGroups.length-1].tasks.push(item);
  });
  /* Fix: group might push to wrong group if equipment not contiguous - rebuild properly */
  var pgMap={};
  items.forEach(function(item){if(!pgMap[item.e.id])pgMap[item.e.id]={e:item.e,tasks:[]};pgMap[item.e.id].tasks.push(item);});
  printGroups=Object.values(pgMap);
  printGroups.sort(function(a,b){var aOv=a.tasks.some(function(t){return t.r.s==='overdue';});var bOv=b.tasks.some(function(t){return t.r.s==='overdue';});return aOv&&!bOv?-1:!aOv&&bOv?1:0;});
  var totalOv=items.filter(function(x){return x.r.s==='overdue';}).length;
  var totalDu=items.filter(function(x){return x.r.s==='due';}).length;
  var body='';
  body+='<div class="phdr"><div><div class="coname">WS Lawn Care Services, LLC</div><div class="cosub">Equipment Maintenance Work Orders<br>'+dateStr+(tech?' - Assigned: <b>'+tech+'</b>':'')+'</div></div><div class="coinfo">321-209-0668<br>info@wslawncareservicesllc.com<br>wslawncareservicesllc.com<br>Titusville, FL</div></div>';
  body+='<div class="sumbar"><div><b>Equipment:</b> '+printGroups.length+'</div><div><b>Tasks:</b> '+items.length+'</div><div><b>Overdue:</b> '+totalOv+'</div><div><b>Due Soon:</b> '+totalDu+'</div>'+(tech?'<div><b>Tech:</b> '+tech+'</div>':'')+(instr?'<div style="flex:1"><b>Priority:</b> '+instr+'</div>':'')+'</div>';
  /* One section per equipment, all tasks inside */
  printGroups.forEach(function(pg){
    var e=pg.e;
    var grpNoteKey='grp-'+e.id;
    var mn=WO_NOTES[grpNoteKey]||'';
    var pgOv=pg.tasks.filter(function(t){return t.r.s==='overdue';}).length;
    var pgDu=pg.tasks.filter(function(t){return t.r.s==='due';}).length;
    body+='<div class="wo">';
    /* Equipment header */
    body+='<div class="eq-hdr">';
    body+='<div style="flex:1"><div class="eq-name">'+e.name+'</div>';
    body+='<div class="wo-m">'+e.type+' &#183; '+(e.make||'')+' '+(e.model||'')+' &#183; S/N: '+(e.serial||'-')+'<br>';
    body+='Current: '+(e.hours||0)+'hrs'+(e.miles?' / '+e.miles.toLocaleString()+'mi':'')+' &#183; $'+(e.cph?e.cph.toFixed(2):'-')+'/hr'+(tech?' &#183; Tech: '+tech:'')+'</div></div>';
    body+='<div style="display:flex;gap:5px;flex-direction:column;align-items:flex-end">';
    if(pgOv)body+='<span class="badge bov">'+pgOv+' Overdue</span>';
    if(pgDu)body+='<span class="badge bdu">'+pgDu+' Due Soon</span>';
    body+='</div></div>';
    if(mn)body+='<div class="mgr"><b>Manager Notes</b>'+mn+'</div>';
    /* Task checklist table */
    body+='<table><tr><th style="width:30%">Task</th><th style="width:15%">Interval</th><th style="width:16%">Status</th><th style="width:55px">Done</th><th style="width:65px">Initial</th><th>Parts / Notes</th></tr>';
    pg.tasks.forEach(function(t){
      var i=t.i,r=t.r;
      body+='<tr><td><b>'+i.task+'</b></td>';
      body+='<td>Every '+i.freq+' '+i.unit+'</td>';
      body+='<td style="color:'+(r.s==='overdue'?'#c62828':'#e65100')+';font-weight:600">'+r.lbl+'</td>';
      body+='<td></td><td></td><td></td></tr>';
    });
    body+='</table>';
    /* Return-to-office fields */
    body+='<div class="ret"><div><div class="retl">Hours at Service</div><div class="retf">&nbsp;</div></div><div><div class="retl">Miles at Service</div><div class="retf">&nbsp;</div></div><div><div class="retl">Parts Cost $</div><div class="retf">&nbsp;</div></div><div><div class="retl">Labor Hours</div><div class="retf">&nbsp;</div></div></div>';
    /* Tech notes section */
    body+='<div class="notes-sec"><div class="notes-hdr"><span>Tech Notes - Findings &amp; What Was Done</span><span>Issues / Parts Needed / Follow-Up</span></div>';
    body+='<div class="notes-body"><div class="notes-col"><div class="nclbl">General Notes</div><div class="nline"></div><div class="nline"></div><div class="nline"></div><div class="nfine">e.g. mower hours from timer, condition found, oil brand used</div></div>';
    body+='<div class="notes-col"><div class="nclbl">Issues &amp; Follow-Up Items</div><div class="nline"></div><div class="nline"></div><div class="nline"></div><div class="nfine">e.g. belt worn, part ordered #_____, needs re-check</div></div></div></div>';
    body+='<div class="sign"><span>Tech Signature &amp; Date: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span>Equipment Hours (mower timer): ___________</span></div>';
    body+='</div>';
  });
  body+='<div class="footer">"Jesus First Before Profits" &nbsp;- "You Grow It, We Mow It!" &nbsp;- "Commitment Without Compromise"<br>WS Lawn Care Services, LLC - Titusville, FL - 321-209-0668 - wslawncareservicesllc.com</div>';
  var w=window.open('','_blank','width=870,height=1050');
  w.document.write('<!DOCTYPE html><html><head><title>WS Lawn Care Work Orders</title><style>'+css+'</style></head><body>'+body+'<script>window.onload=function(){window.print();}<\/script></body></html>');
  w.document.close();}

var CAL_MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
function chMo(d){CAL_M+=d;if(CAL_M>11){CAL_M=0;CAL_Y++;}if(CAL_M<0){CAL_M=11;CAL_Y--;}renderCal();}
function renderCal(){document.getElementById('cal-label').textContent=CAL_MONTHS[CAL_M]+' '+CAL_Y;var dows=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];var h=dows.map(function(d){return '<div class="cal-dow">'+d+'</div>';}).join('');var fd=new Date(CAL_Y,CAL_M,1).getDay();var dim=new Date(CAL_Y,CAL_M+1,0).getDate();var now=new Date();var em={};S.equipment.forEach(function(e){(e.intervals||[]).forEach(function(i){var r=iStat(e,i);if(r.dd){var k=r.dd.toISOString().split('T')[0];if(!em[k])em[k]=[];em[k].push({s:r.s,lbl:i.task,en:e.name});}});});for(var p=0;p<fd;p++)h+='<div class="cal-cell om"></div>';for(var d=1;d<=dim;d++){var it=now.getDate()===d&&now.getMonth()===CAL_M&&now.getFullYear()===CAL_Y;var dk=CAL_Y+'-'+String(CAL_M+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');var evs=em[dk]||[];h+='<div class="cal-cell'+(it?' today':'')+'"><div class="cal-dn">'+d+'</div>';evs.slice(0,3).forEach(function(ev){h+='<div class="cal-ev cev-'+ev.s+'" title="'+ev.en+'">'+ev.lbl+'</div>';});if(evs.length>3)h+='<div style="font-size:9px;color:var(--gr)">+'+( evs.length-3)+' more</div>';h+='</div>';}document.getElementById('cal-grid').innerHTML=h;}

function renderBulk(){BULK_DRAFT={};var hrsEq=S.equipment.filter(function(e){var types=['Stand-On Mower','Walk-Behind Mower','Zero-Turn Mower','Push Mower','Trimmer / Edger','Blower','Chainsaw','Pole Saw','Pressure Washer','Attachments / Other','Climbing Gear'];return types.indexOf(e.type)>=0;});var miEq=S.equipment.filter(function(e){return e.type==='Truck';});var hh='';hrsEq.forEach(function(e){hh+=buildBulkCard(e,'hours');});document.getElementById('bulk-hrs-grid').innerHTML=hh;var mh='';miEq.forEach(function(e){mh+=buildBulkCard(e,'miles');});document.getElementById('bulk-mi-grid').innerHTML=mh;renderBulkPreview();}
function buildBulkCard(e,mode){var cur=mode==='hours'?(e.hours||0):(e.miles||0);var unit=mode==='hours'?'hrs':'mi';var als=getBulkAlerts(e,cur,mode);return '<div class="bulk-card" id="bc-'+e.id+'"><div class="bulk-ico-row"><div class="bulk-ico">'+eico(e)+'</div><div><div class="bulk-name">'+e.name+'</div><div class="bulk-cur">Current: <b>'+cur.toLocaleString()+' '+unit+'</b></div></div></div><div class="bulk-inp-row"><input type="number" id="bulk-'+e.id+'" value="'+cur+'" min="'+cur+'" data-eid="'+e.id+'" data-mode="'+mode+'" oninput="handleBulkInput(this)" placeholder="'+cur+'"><span class="bulk-unit">'+unit+'</span><span class="bulk-delta same" id="bd-'+e.id+'">no change</span></div><div id="ba-'+e.id+'">'+als+'</div></div>';}
function getBulkAlerts(e,curVal,mode){var rel=(e.intervals||[]).filter(function(i){return i.unit===mode;});if(!rel.length)return '<div class="bulk-alert ok">No '+mode+'-based intervals</div>';var h='';rel.forEach(function(i){var fakeE=JSON.parse(JSON.stringify(e));if(mode==='hours')fakeE.hours=curVal;else fakeE.miles=curVal;var r=iStat(fakeE,i);h+='<div class="bulk-alert '+r.s+'">'+(r.s==='overdue'?'&#128308;':r.s==='due'?'&#128993;':'&#9989;')+' '+i.task+': '+r.lbl+'</div>';});return h;}
function bulkChange(eid,mode,rawVal){var val=parseFloat(rawVal)||0;var e=ge(eid);if(!e)return;var cur=mode==='hours'?(e.hours||0):(e.miles||0);BULK_DRAFT[eid]={mode:mode,val:val};var card=document.getElementById('bc-'+eid);var delta=document.getElementById('bd-'+eid);var alEl=document.getElementById('ba-'+eid);if(val!==cur){if(card)card.classList.add('changed');var diff=val-cur;if(delta){delta.textContent=(diff>0?'+':'')+diff.toLocaleString()+(mode==='hours'?' hrs':' mi');delta.className='bulk-delta '+(diff>0?'pos':'same');}var fakeE=JSON.parse(JSON.stringify(e));if(mode==='hours')fakeE.hours=val;else fakeE.miles=val;if(alEl)alEl.innerHTML=getBulkAlerts(fakeE,val,mode);}else{if(card)card.classList.remove('changed');if(delta){delta.textContent='no change';delta.className='bulk-delta same';}}renderBulkPreview();}
function renderBulkPreview(){var el=document.getElementById('bulk-preview');var newAlerts=[];S.equipment.forEach(function(e){var draft=BULK_DRAFT[e.id];var fakeE=draft?JSON.parse(JSON.stringify(e)):e;if(draft){if(draft.mode==='hours')fakeE.hours=draft.val;else fakeE.miles=draft.val;}(e.intervals||[]).forEach(function(i){var r=iStat(fakeE,i);if(r.s!=='ok')newAlerts.push({s:r.s,lbl:r.lbl,en:e.name,task:i.task});});});newAlerts.sort(function(a,b){return a.s==='overdue'?-1:1;});if(!newAlerts.length){el.innerHTML='<div class="alert-item a-ok"><div class="alert-dot dot-g"></div><div>All maintenance up to date after save!</div></div>';return;}var h='<div style="font-size:11px;color:var(--gr);margin-bottom:7px">'+newAlerts.length+' outstanding task'+(newAlerts.length!==1?'s':'')+' after updates</div>';newAlerts.slice(0,12).forEach(function(a){h+='<div class="alert-item a-'+a.s+'"><div class="alert-dot dot-'+(a.s==='overdue'?'r':'a')+'"></div><div><div style="font-weight:600;font-size:12px">'+a.task+'</div><div style="font-size:10px;color:var(--gr)">'+a.en+' - '+a.lbl+'</div></div></div>';});el.innerHTML=h;}
function bulkSave(){var count=0;Object.keys(BULK_DRAFT).forEach(function(eid){var d=BULK_DRAFT[eid];var e=ge(eid);if(!e)return;var cur=d.mode==='hours'?(e.hours||0):(e.miles||0);if(d.val===cur)return;if(d.mode==='hours'){logAct(e.name,'Hours: '+cur+' to '+d.val);e.hours=d.val;}else{logAct(e.name,'Miles: '+cur.toLocaleString()+' to '+d.val.toLocaleString());e.miles=d.val;}count++;});save();BULK_DRAFT={};toast(count+' piece'+(count!==1?'s':'')+' updated');renderBulk();renderDash();}
function bulkReset(){BULK_DRAFT={};renderBulk();toast('Changes reset');}

function closeM(id){document.getElementById(id).style.display='none';}
document.querySelectorAll('.modal-overlay').forEach(function(o){o.addEventListener('click',function(e){if(e.target===this)closeM(this.id);});});

initApiUrl();
load();
renderDash();
var wfBtn=document.getElementById('wf-all');if(wfBtn){wfBtn.style.background='var(--gl)';wfBtn.style.color='var(--gd)';}
renderWO();
var woDate=document.getElementById('wo-date');if(woDate)woDate.value=td();
addCloudNavItem();

/* ---- COLLAPSIBLE SIDEBAR ---- */
var SB_KEY='ws_sidebar_collapsed';
function setSidebar(c){
  var sb=document.querySelector('.sidebar');if(!sb)return;
  if(c)sb.classList.add('collapsed');else sb.classList.remove('collapsed');
  var b=document.getElementById('sb-toggle');
  if(b){b.innerHTML=c?'&#187;':'&#171;';b.title=c?'Expand menu':'Collapse menu';}
  try{localStorage.setItem(SB_KEY,c?'1':'0');}catch(e){}
}
function toggleSidebar(){var sb=document.querySelector('.sidebar');setSidebar(!(sb&&sb.classList.contains('collapsed')));}
try{setSidebar(localStorage.getItem(SB_KEY)==='1');}catch(e){}
window.toggleSidebar = toggleSidebar;

/* ---- NAV WRAPPER FUNCTIONS (Wix-safe - no args in onclick) ---- */
function navDashboard(){var n=document.querySelectorAll('.nav-item');nav('dashboard',n[0]);}
function navEquipment(){var n=document.querySelectorAll('.nav-item');nav('equipment',n[1]);}
function navWorkorders(){var n=document.querySelectorAll('.nav-item');nav('workorders',n[2]);}
function navCalendar(){var n=document.querySelectorAll('.nav-item');nav('calendar',n[3]);}
function navBulkhours(){var n=document.querySelectorAll('.nav-item');nav('bulkhours',n[4]);}
function dTabIntervals(el){dTab('intervals',el);}
function dTabHistory(el){dTab('history',el);}
function dTabSpecs(el){dTab('specs',el);}
function setWFAll(el){setWF('all',el);}
function setWFOverdue(el){setWF('overdue',el);}
function setWFDue(el){setWF('due',el);}
function selAllTrue(){selAll(true);}
function selAllFalse(){selAll(false);}
function closeMEquip(){closeM('m-equip');}
function closeMSvc(){closeM('m-svc');}
function closeMApi(){closeM('m-api');}

/* ---- DYNAMIC ACTION REGISTRY --------------------------------
   WF(n) dispatches to a registered function by integer key.
   Used instead of onclick with string args (Wix-safe).
   Registry is rebuilt whenever dynamic HTML is regenerated.
---------------------------------------------------------------- */
var _WFR = {};
var _WFC = 0;
function wfReg(fn) {
  var k = _WFC++;
  _WFR[k] = fn;
  return k;
}
function WF(k) {
  if (_WFR[k]) _WFR[k]();
}
function wfClear() {
  _WFR = {};
  _WFC = 0;
}
/* Expose on window so Wix iframe onclick attributes can reach it */
window.WF = WF;
window.wfReg = wfReg;
window.wfClear = wfClear;

/* Helpers for inline event handlers on dynamically built elements */
function handleMgrNote(el) {
  var key = el.getAttribute('data-key');
  if (key) WO_NOTES[key] = el.value;
}
function handleBulkInput(el) {
  var eid = el.getAttribute('data-eid');
  var mode = el.getAttribute('data-mode');
  if (eid && mode) bulkChange(eid, mode, el.value);
}


/* ── API SETUP & CONNECTION ────────────────────────────────── */
var API_STORAGE_KEY = 'ws_api_url_v1';

function initApiUrl() {
  /* API_URL is hardcoded above — check if user has overridden with a newer URL */
  var saved = localStorage.getItem(API_STORAGE_KEY);
  if (saved && saved.indexOf('script.google.com') >= 0) {
    API_URL = saved; /* use override if set */
  }
  /* Hide setup notice since we have a built-in URL */
  var notice = document.getElementById('api-setup-notice');
  if (notice) notice.style.display = 'none';
}

function openApiSetup() {
  var input = document.getElementById('api-url-input');
  if (input) input.value = API_URL || '';
  var result = document.getElementById('api-test-result');
  if (result) result.textContent = '';
  closeM('m-api'); /* close if already open */
  document.getElementById('m-api').style.display = 'flex';
}

function saveApiUrl() {
  var input = document.getElementById('api-url-input');
  if (!input) return;
  var url = input.value.trim();
  if (!url) {
    alert('Please enter your Apps Script Web App URL.');
    return;
  }
  if (url.indexOf('script.google.com') < 0) {
    alert('That does not look like a Google Apps Script URL. It should start with https://script.google.com/macros/s/...');
    return;
  }
  API_URL = url;
  localStorage.setItem(API_STORAGE_KEY, url);
  closeM('m-api');
  var notice = document.getElementById('api-setup-notice');
  if (notice) notice.style.display = 'none';
  /* Test connection then push data */
  setApiStatus('syncing', 'Connecting to Google Sheets...');
  apiGet({action:'ping'}, function(result) {
    if (result && result.ok) {
      /* Connection works — push fleet one piece at a time */
      setApiStatus('syncing', 'Saving fleet to Google Sheets...');
      syncSequential(S.equipment, 0, 0, function(saved, failed) {
        if (failed === 0) {
          setApiStatus('ok', 'Connected! ' + saved + ' pieces synced');
          toast('Connected to Google Sheets');
          load();
        } else {
          setApiStatus('error', saved + ' saved, ' + failed + ' failed');
          toast('Some saves failed - check Apps Script');
        }
      });
    } else {
      setApiStatus('error', 'Connection failed - check your URL');
      toast('Connection failed - check your URL');
    }
  });
}

function testApiConnection() {
  var input = document.getElementById('api-url-input');
  var result = document.getElementById('api-test-result');
  if (!input || !result) return;
  var url = input.value.trim();
  if (!url) { result.textContent = 'Enter a URL first'; return; }
  result.textContent = 'Testing...';
  result.style.color = 'var(--am)';
  fetch(url + '?action=ping')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d && d.ok) {
        result.textContent = 'Connection successful!';
        result.style.color = 'var(--gd)';
      } else {
        result.textContent = 'Connected but unexpected response';
        result.style.color = 'var(--am)';
      }
    })
    .catch(function(err) {
      result.textContent = 'Failed: ' + err.message;
      result.style.color = 'var(--rd)';
    });
}

/* Add "Cloud Settings" to the sidebar */
function addCloudNavItem() {
  var navSection = document.querySelector('.sidebar > div');
  if (!navSection) return;
  var div = document.createElement('div');
  div.className = 'nav-item';
  div.title = 'Cloud / Google Sheets Settings';
  div.onclick = openApiSetup;
  div.innerHTML = '<span class="ni">&#9729;&#65039;</span> <span>Cloud Settings</span>';
  navSection.appendChild(div);
}


/* ── FORCE SYNC FUNCTIONS ───────────────────────────────────── */
function rerenderActive() {
  var active = document.querySelector('.page.active');
  if (!active) return;
  var pid = active.id.replace('page-','');
  if (pid === 'dashboard')  renderDash();
  if (pid === 'equipment')  renderEqList();
  if (pid === 'workorders') renderWO();
  if (pid === 'calendar')   renderCal();
  if (pid === 'bulkhours')  renderBulk();
  if (pid === 'repairs')    renderRepairs();
}

function forceSync() {
  setApiStatus('syncing', 'Checking Google Sheets...');
  apiGet({action:'getAll'}, function(data) {
    if (data && data.ok) {
      mergeFromSheet(data);
      afterMerge('Synced ' + S.equipment.length + ' pieces');
      toast('Synced with Google Sheets');pullRepairs();
      rerenderActive();
    } else {
      setApiStatus('error', 'Refresh failed - using local data');
      toast('Could not reach Google Sheets');
    }
  });
}

/* ── FIRST-TIME SHEET BOOTSTRAP ─────────────────────────────── */
function bootstrapSheets() {
  if (!API_URL) return;
  apiGet({action:'getAll'}, function(data) {
    if (data && data.ok) {
      mergeFromSheet(data);
      afterMerge('Loaded ' + S.equipment.length + ' pieces');
      renderDash();
      renderWO();
    } else {
      setApiStatus('error', 'Cannot reach Google Sheets — using local data');
    }
  });
}


/* ================= REPAIR REQUESTS =================
   Crew submit requests; managers triage them here.
   Stored in S.repairs (localStorage) and synced to a separate
   Google Sheet tab through saveRepair / getRepairs / deleteRepair.
   Unsynced changes are queued and retried, never lost.
===================================================== */
var REP_Q_KEY='ws_rep_pending_v1', REP_DQ_KEY='ws_rep_pending_del_v1', REP_TECH_KEY='ws_rep_tech_v1';
var REP_Q=[], REP_DQ=[], REP_BUSY=false, REP_AGAIN=false, REP_FILTER='open', REP_URG='Medium', REP_LAST_PULL=0;
try{REP_Q=JSON.parse(localStorage.getItem(REP_Q_KEY)||'[]');}catch(e){REP_Q=[];}
try{REP_DQ=JSON.parse(localStorage.getItem(REP_DQ_KEY)||'[]');}catch(e){REP_DQ=[];}
var URG_INFO={
  Low:{rank:0,cls:'low',hint:'Can wait - cosmetic or minor'},
  Medium:{rank:1,cls:'med',hint:'Fix within the week'},
  High:{rank:2,cls:'high',hint:'Fix before next use'},
  Critical:{rank:3,cls:'crit',hint:'Unsafe or down - stop using it'}
};
var REP_STATUS={open:'Open',prog:'In Progress',done:'Completed'};

function repEsc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function repAll(){if(!S.repairs)S.repairs=[];return S.repairs;}
function repFind(id){var a=repAll();for(var i=0;i<a.length;i++){if(a[i].id===id)return a[i];}return null;}
function repFmtDate(d){if(!d)return '';var s=String(d).slice(0,10);var x=new Date(s+'T12:00:00');return isNaN(x.getTime())?s:x.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});}
function repNorm(x){
  var r={};['id','tech','date','urgency','equipId','equipName','desc','status','completedDate','created','updatedAt','photos'].forEach(function(k){r[k]=(x[k]==null)?'':String(x[k]);});
  if(!URG_INFO[r.urgency])r.urgency='Medium';
  if(!REP_STATUS[r.status])r.status='open';
  return r;
}
function repPhotoIds(r){
  if(!r||!r.photos)return [];
  try{var a=JSON.parse(r.photos);return (Array.isArray(a)?a:[]).map(function(p){return p&&p.id?String(p.id).replace(/[^A-Za-z0-9_-]/g,''):'';}).filter(Boolean);}catch(e){return [];}
}
function repPersist(){try{localStorage.setItem(SK,JSON.stringify(S));}catch(e){}}
function repSaveQ(){try{localStorage.setItem(REP_Q_KEY,JSON.stringify(REP_Q));}catch(e){}}
function repSaveDQ(){try{localStorage.setItem(REP_DQ_KEY,JSON.stringify(REP_DQ));}catch(e){}}
function repMarkDirty(id){if(REP_Q.indexOf(id)<0)REP_Q.push(id);repSaveQ();repPersist();syncRepairs();}

function repNote(state){
  var el=document.getElementById('rep-sync-note');if(!el)return;
  var pend=REP_Q.length+REP_DQ.length,m='',c='var(--gr)';
  if(!API_URL){m='Cloud sync is off - requests are saved on this device only.';}
  else if(state==='ok'&&!pend){m='Synced with Google Sheets at '+nowTime()+'.';c='var(--gd)';}
  else if(pend){m=pend+' change'+(pend>1?'s are':' is')+' saved on this device but not in Google Sheets yet. Make sure the repair-request code is added to your Apps Script, then tap Refresh.';c='var(--am)';}
  else if(state==='unreachable'){m='Could not load repair requests from Google Sheets - showing what is saved on this device. If this is new, the Apps Script needs the repair-request update.';c='var(--am)';}
  el.textContent=m;el.style.color=c;
}

function repBadge(){
  var n=repAll().filter(function(r){return r.status!=='done';}).length;
  var b=document.getElementById('nav-rep-badge');if(!b)return;
  b.textContent=n;if(n>0)b.classList.add('show');else b.classList.remove('show');
  var tbb=document.getElementById('tb-rep-badge');if(tbb){tbb.textContent=n;if(n>0)tbb.classList.add('show');else tbb.classList.remove('show');}
}

/* push queued saves/deletes to the sheet, one at a time */
function syncRepairs(){
  if(!API_URL)return;
  if(REP_BUSY){REP_AGAIN=true;return;}
  var tasks=REP_DQ.map(function(id){return {del:id};}).concat(REP_Q.map(function(id){return {id:id};}));
  if(!tasks.length){return;}
  REP_BUSY=true;
  (function next(i,fail){
    if(i>=tasks.length){
      REP_BUSY=false;repNote(fail?'fail':'ok');
      if(REP_AGAIN){REP_AGAIN=false;syncRepairs();}
      return;
    }
    var t=tasks[i];
    if(t.del){
      apiGet({action:'deleteRepair',id:t.del},function(r){
        if(r&&(r.ok||(r.error&&String(r.error).indexOf('Not found')===0))){REP_DQ=REP_DQ.filter(function(x){return x!==t.del;});repSaveDQ();next(i+1,fail);}
        else next(i+1,fail+1);
      });
    }else{
      var rep=repFind(t.id);
      if(!rep){REP_Q=REP_Q.filter(function(x){return x!==t.id;});repSaveQ();next(i+1,fail);return;}
      var snap=rep.updatedAt;
      apiGet({action:'saveRepair',data:rep},function(r){
        if(r&&r.ok){if(rep.updatedAt===snap){REP_Q=REP_Q.filter(function(x){return x!==t.id;});repSaveQ();}next(i+1,fail);}
        else next(i+1,fail+1);
      });
    }
  })(0,0);
}

/* pull the shared list; unsynced local changes always win until they are saved */
function pullRepairs(){
  if(!API_URL)return;
  REP_LAST_PULL=Date.now();
  apiGet({action:'getRepairs'},function(r){
    if(r&&r.ok&&Array.isArray(r.repairs)){
      var out=[];
      r.repairs.forEach(function(x){
        if(!x||!x.id||REP_DQ.indexOf(String(x.id))>=0)return;
        var loc=repFind(String(x.id));
        if(loc&&REP_Q.indexOf(loc.id)>=0){loc.photos=String(x.photos||'');out.push(loc);}else out.push(repNorm(x));
      });
      REP_Q.forEach(function(id){var l=repFind(id);if(l&&!out.some(function(o){return o.id===id;}))out.push(l);});
      S.repairs=out;repPersist();
      if(REP_Q.length||REP_DQ.length)syncRepairs();else repNote('ok');
    }else{
      repNote(REP_Q.length||REP_DQ.length?'fail':'unreachable');
      if(REP_Q.length||REP_DQ.length)syncRepairs();
    }
    repBadge();
    var pg=document.getElementById('page-repairs');
    if(pg&&pg.classList.contains('active'))repRenderList();
  });
}
function repRefresh(){toast('Refreshing...');if(API_URL)pullRepairs();else repRenderList();}

function repBuildEquip(){
  var sel=document.getElementById('rp-equip');if(!sel)return;
  var cur=sel.value;
  var list=S.equipment.slice().sort(function(a,b){return String(a.name).localeCompare(String(b.name));});
  var h='<option value="">- select equipment -</option>';
  list.forEach(function(e){h+='<option value="'+repEsc(e.id)+'">'+repEsc(e.name)+'</option>';});
  h+='<option value="__other">Other / Not Listed</option>';
  sel.innerHTML=h;if(cur)sel.value=cur;
}
function repSetUrg(u){
  if(!URG_INFO[u])return;REP_URG=u;
  var btns=document.querySelectorAll('#rp-urg button');
  for(var i=0;i<btns.length;i++){if(btns[i].getAttribute('data-urg')===u)btns[i].classList.add('on');else btns[i].classList.remove('on');}
  var h=document.getElementById('rp-urg-hint');if(h)h.textContent=URG_INFO[u].hint;
}

function renderRepairs(){
  repBuildEquip();repSetUrg(REP_URG);
  var d=document.getElementById('rp-date');if(d&&!d.value)d.value=td();
  var t=document.getElementById('rp-tech');
  if(t&&!t.value){try{t.value=localStorage.getItem(REP_TECH_KEY)||'';}catch(e){}}
  repRenderList();repNote(API_URL?'':'');
  if(API_URL&&Date.now()-REP_LAST_PULL>15000)pullRepairs();
}

function repRenderList(){
  var all=repAll().map(function(r){return r;});
  var open=all.filter(function(r){return r.status!=='done';});
  var done=all.filter(function(r){return r.status==='done';});
  open.sort(function(a,b){var d=URG_INFO[b.urgency].rank-URG_INFO[a.urgency].rank;if(d)return d;return String(a.date).localeCompare(String(b.date));});
  done.sort(function(a,b){return String(b.completedDate||b.date).localeCompare(String(a.completedDate||a.date));});
  var shown=REP_FILTER==='open'?open:REP_FILTER==='done'?done:open.concat(done);
  var btns=document.querySelectorAll('#rep-filter [data-rfilter]');
  for(var i=0;i<btns.length;i++){if(btns[i].getAttribute('data-rfilter')===REP_FILTER)btns[i].classList.add('on');else btns[i].classList.remove('on');}
  document.getElementById('rep-count').textContent=open.length+' open, '+done.length+' completed';
  var el=document.getElementById('rep-list');
  if(!shown.length){
    el.innerHTML='<div class="empty-state"><div class="es-icon">'+(REP_FILTER==='done'?'&#128203;':'&#9989;')+'</div><div class="es-title">'+(REP_FILTER==='done'?'No completed repairs yet':'No open repair requests')+'</div><div class="es-sub">'+(REP_FILTER==='done'?'Finished repairs will show up here.':'New requests from the crew will appear here.')+'</div></div>';
    repBadge();return;
  }
  var h='';
  shown.forEach(function(r){
    var u=URG_INFO[r.urgency];
    h+='<div class="rep-card u-'+u.cls+(r.status==='done'?' is-done':'')+'">';
    h+='<div class="rep-top"><div style="min-width:0"><div class="rep-eq">'+repEsc(r.equipName||'Unknown equipment')+'</div>';
    h+='<div class="rep-meta">Reported by <b>'+repEsc(r.tech)+'</b> &#183; '+repEsc(repFmtDate(r.date))+'</div></div>';
    h+='<div class="rep-badges"><span class="badge rb-'+u.cls+'">'+repEsc(r.urgency)+'</span><span class="badge rs-'+r.status+'">'+REP_STATUS[r.status]+'</span></div></div>';
    h+='<div class="rep-desc">'+repEsc(r.desc).replace(/\n/g,'<br>')+'</div>';
    var _ph=repPhotoIds(r);
    if(_ph.length){h+='<div class="rep-photos">';_ph.forEach(function(id){h+='<img class="rep-ph" loading="lazy" data-ph="'+id+'" src="https://lh3.googleusercontent.com/d/'+id+'=w300" alt="Repair photo">';});h+='</div>';}
    if(r.status==='done'&&r.completedDate)h+='<div class="rep-done-line">&#10004; Completed '+repEsc(repFmtDate(r.completedDate))+'</div>';
    h+='<div class="rep-actions no-print">';
    if(r.status==='open')h+='<button class="btn btn-amber btn-sm" data-ract="prog" data-id="'+repEsc(r.id)+'">&#9654; Start Work</button>';
    if(r.status!=='done')h+='<button class="btn btn-primary btn-sm" data-ract="done" data-id="'+repEsc(r.id)+'">&#10004; Mark Complete</button>';
    if(r.status!=='open')h+='<button class="btn btn-secondary btn-sm" data-ract="open" data-id="'+repEsc(r.id)+'">&#8617; '+(r.status==='done'?'Reopen':'Back to Open')+'</button>';
    if(r.equipId&&ge(r.equipId))h+='<button class="btn btn-secondary btn-sm" data-ract="view" data-id="'+repEsc(r.id)+'">View Equipment</button>';
    h+='<button class="btn btn-danger btn-sm" data-ract="del" data-id="'+repEsc(r.id)+'">&#128465;&#65039; Delete</button>';
    h+='</div></div>';
  });
  el.innerHTML=h;repBadge();
}

function submitRepair(){
  var tech=document.getElementById('rp-tech').value.trim();
  var date=document.getElementById('rp-date').value;
  var eid=document.getElementById('rp-equip').value;
  var desc=document.getElementById('rp-desc').value.trim();
  if(!tech){alert('Please enter your name.');return;}
  if(!date){alert('Please pick a date.');return;}
  if(!eid){alert('Please select the equipment.');return;}
  if(!desc){alert('Please describe the repair needed.');return;}
  var eq=eid==='__other'?null:ge(eid);
  var now=new Date().toISOString();
  var rep={id:'rr'+Date.now()+Math.floor(Math.random()*1000),tech:tech,date:date,urgency:REP_URG,equipId:eq?eq.id:'',equipName:eq?eq.name:'Other / Not Listed',desc:desc,status:'open',completedDate:'',created:now,updatedAt:now};
  repAll().push(rep);
  try{localStorage.setItem(REP_TECH_KEY,tech);}catch(e){}
  logAct(rep.equipName,'Repair requested ('+rep.urgency+'): '+(desc.length>60?desc.slice(0,57)+'...':desc));
  repMarkDirty(rep.id);
  document.getElementById('rp-desc').value='';
  document.getElementById('rp-equip').value='';
  REP_FILTER='open';
  repRenderList();
  toast('Repair request submitted');
  if(!API_URL)repNote('');
}

function repSetStatus(id,st){
  var r=repFind(id);if(!r)return;
  r.status=st;r.completedDate=st==='done'?td():'';r.updatedAt=new Date().toISOString();
  logAct(r.equipName,'Repair '+(st==='done'?'completed':st==='prog'?'started':'reopened')+': '+(r.desc.length>50?r.desc.slice(0,47)+'...':r.desc));
  repMarkDirty(id);repRenderList();
}
function repDelete(id){
  var r=repFind(id);if(!r)return;
  if(!confirm('Delete this repair request for "'+r.equipName+'"?'))return;
  S.repairs=repAll().filter(function(x){return x.id!==id;});
  REP_Q=REP_Q.filter(function(x){return x!==id;});repSaveQ();
  if(REP_DQ.indexOf(id)<0)REP_DQ.push(id);repSaveDQ();
  repPersist();syncRepairs();repRenderList();toast('Request deleted');
}
function navRepairs(){var n=document.querySelectorAll('.nav-item');nav('repairs',n[5]);}

function initRepairs(){
  var ul=document.getElementById('rep-list');
  if(ul)ul.addEventListener('click',function(ev){
    var b=ev.target.closest?ev.target.closest('[data-ract]'):null;if(!b)return;
    var act=b.getAttribute('data-ract'),id=b.getAttribute('data-id');
    if(act==='view'){var r=repFind(id);if(r&&r.equipId)openDetail(r.equipId);}
    else if(act==='del')repDelete(id);
    else repSetStatus(id,act);
  });
  if(ul){
    ul.addEventListener('click',function(ev){
      var im=ev.target;if(!im||!im.getAttribute||!im.getAttribute('data-ph'))return;
      var id=im.getAttribute('data-ph');
      document.getElementById('ph-lb-img').src='https://lh3.googleusercontent.com/d/'+id+'=w1600';
      document.getElementById('ph-lb-open').href='https://drive.google.com/file/d/'+id+'/view';
      document.getElementById('ph-lb').classList.add('open');
    });
    /* if the fast image address is refused, fall back to Drive's own thumbnail address once */
    ul.addEventListener('error',function(ev){
      var im=ev.target;if(!im||!im.getAttribute||!im.getAttribute('data-ph')||im.getAttribute('data-fb'))return;
      im.setAttribute('data-fb','1');im.src='https://drive.google.com/thumbnail?id='+im.getAttribute('data-ph')+'&sz=w300';
    },true);
  }
  var lb=document.getElementById('ph-lb');
  if(lb)lb.addEventListener('click',function(ev){if(ev.target.id==='ph-lb-open')return;lb.classList.remove('open');document.getElementById('ph-lb-img').src='';});
  var uf=document.getElementById('rep-filter');
  if(uf)uf.addEventListener('click',function(ev){var b=ev.target.closest?ev.target.closest('[data-rfilter]'):null;if(!b)return;REP_FILTER=b.getAttribute('data-rfilter');repRenderList();});
  var uu=document.getElementById('rp-urg');
  if(uu)uu.addEventListener('click',function(ev){var b=ev.target.closest?ev.target.closest('[data-urg]'):null;if(!b)return;repSetUrg(b.getAttribute('data-urg'));});
  S.repairs=repAll().map(repNorm);
  repBadge();repSetUrg(REP_URG);
  if(API_URL)pullRepairs();
}
window.navRepairs=navRepairs;
window.submitRepair=submitRepair;
window.repRefresh=repRefresh;
initRepairs();

/* ================= SUPPLIES & REORDERS =================
   Shopping / pickup list + repeat orders + stores.
   Saved on this device right away and synced to the MAINT_Supplies tab
   (getSupplies / saveSupply / deleteSupply in the Apps Script).
   Unsynced changes are queued and retried, never lost.
========================================================= */
var SUP_KEY='ws_supplies_v1', SUP_Q_KEY='ws_sup_pending_v1', SUP_DQ_KEY='ws_sup_pending_del_v1', SUP_SEED_KEY='ws_sup_seeded_v1', SUP_MAIL_KEY='ws_sup_email_v1';
var SUP=[], SUP_Q=[], SUP_DQ=[], SUP_BUSY=false, SUP_AGAIN=false, SUP_FILTER='open', SUP_EDIT=null, SUP_EDIT_ST=null, SUP_GROUP_IDS=[];
try{SUP=JSON.parse(localStorage.getItem(SUP_KEY)||'[]');if(!Array.isArray(SUP))SUP=[];}catch(e){SUP=[];}
try{SUP_Q=JSON.parse(localStorage.getItem(SUP_Q_KEY)||'[]');}catch(e){SUP_Q=[];}
try{SUP_DQ=JSON.parse(localStorage.getItem(SUP_DQ_KEY)||'[]');}catch(e){SUP_DQ=[];}

function supEl(id){return document.getElementById(id);}
function supEsc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function supUid(){return 'sp'+Date.now().toString(36)+Math.random().toString(36).substr(2,5);}
function supPersist(){try{localStorage.setItem(SUP_KEY,JSON.stringify(SUP));}catch(e){}}
function supSaveQ(){try{localStorage.setItem(SUP_Q_KEY,JSON.stringify(SUP_Q));}catch(e){}}
function supSaveDQ(){try{localStorage.setItem(SUP_DQ_KEY,JSON.stringify(SUP_DQ));}catch(e){}}
function supFind(id){for(var i=0;i<SUP.length;i++){if(SUP[i].id===id)return SUP[i];}return null;}
function supKind(k){return SUP.filter(function(x){return x.kind===k;});}
function supToday(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function supDays(due){if(!due)return null;return Math.round((new Date(due+'T12:00:00')-new Date(supToday()+'T12:00:00'))/864e5);}
function supFmtDate(d){if(!d)return '';var x=new Date(String(d).slice(0,10)+'T12:00:00');return isNaN(x.getTime())?String(d):x.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});}
function supNorm(x){
  var r={};for(var k in x){if(Object.prototype.hasOwnProperty.call(x,k))r[k]=x[k];}
  r.id=String(r.id);if(r.kind!=='staple'&&r.kind!=='store')r.kind='item';
  if(r.kind==='item'){if(['needed','ordered','picked'].indexOf(r.status)<0)r.status='needed';if(r.priority!=='urgent')r.priority='normal';}
  return r;
}
function supCleanUrl(u){u=String(u||'').trim();if(!u)return '';return /^https?:\/\//i.test(u)?u:'https://'+u;}
function supSafeUrl(u){u=String(u||'').trim();return /^https?:\/\//i.test(u)?u:'';}

/* ---------- save / sync ---------- */
function supTouch(rec){
  rec.updatedAt=new Date().toISOString();
  if(SUP_Q.indexOf(rec.id)<0)SUP_Q.push(rec.id);
  supSaveQ();supPersist();supSync();
}
function supRemove(id){
  SUP=SUP.filter(function(x){return x.id!==id;});
  SUP_Q=SUP_Q.filter(function(x){return x!==id;});supSaveQ();
  if(SUP_DQ.indexOf(id)<0)SUP_DQ.push(id);supSaveDQ();
  supPersist();supSync();
}
function supNote(state){
  var el=supEl('sp-sync-note');if(!el)return;
  var pend=SUP_Q.length+SUP_DQ.length,m='',c='var(--gr)';
  if(!API_URL){m='Saved on this device only.';}
  else if(state==='ok'&&!pend){m='Synced '+nowTime();c='var(--gd)';}
  else if(pend){m=pend+' change'+(pend>1?'s':'')+' not synced yet - make sure the v9 Apps Script is deployed, then tap Sync.';c='var(--am)';}
  else if(state==='unreachable'){m='Could not reach Google Sheets - showing what is saved on this device.';c='var(--am)';}
  el.textContent=m;el.style.color=c;
}
function supSync(){
  if(!API_URL)return;
  if(SUP_BUSY){SUP_AGAIN=true;return;}
  var tasks=SUP_DQ.map(function(id){return {del:id};}).concat(SUP_Q.map(function(id){return {id:id};}));
  if(!tasks.length)return;
  SUP_BUSY=true;
  (function next(i,fail){
    if(i>=tasks.length){
      SUP_BUSY=false;supNote(fail?'fail':'ok');
      if(SUP_AGAIN){SUP_AGAIN=false;supSync();}
      return;
    }
    var t=tasks[i];
    if(t.del){
      apiGet({action:'deleteSupply',id:t.del},function(r){
        if(r&&(r.ok||(r.error&&String(r.error).indexOf('Not found')===0))){SUP_DQ=SUP_DQ.filter(function(x){return x!==t.del;});supSaveDQ();next(i+1,fail);}
        else next(i+1,fail+1);
      });
    }else{
      var rec=supFind(t.id);
      if(!rec){SUP_Q=SUP_Q.filter(function(x){return x!==t.id;});supSaveQ();next(i+1,fail);return;}
      var snap=rec.updatedAt;
      apiGet({action:'saveSupply',data:rec},function(r){
        if(r&&r.ok){if(rec.updatedAt===snap){SUP_Q=SUP_Q.filter(function(x){return x!==t.id;});supSaveQ();}next(i+1,fail);}
        else next(i+1,fail+1);
      });
    }
  })(0,0);
}
function supPull(){
  if(!API_URL)return;
  apiGet({action:'getSupplies'},function(r){
    if(r&&r.ok&&Array.isArray(r.supplies)){
      if(!r.supplies.length&&!SUP_DQ.length){
        SUP.forEach(function(x){if(SUP_Q.indexOf(x.id)<0)SUP_Q.push(x.id);});supSaveQ();
      }else{
        var out=[];
        r.supplies.forEach(function(x){
          if(!x||!x.id||SUP_DQ.indexOf(String(x.id))>=0)return;
          var loc=supFind(String(x.id));
          if(loc&&SUP_Q.indexOf(loc.id)>=0)out.push(loc);else out.push(supNorm(x));
        });
        SUP_Q.forEach(function(id){var l=supFind(id);if(l&&!out.some(function(o){return o.id===id;}))out.push(l);});
        SUP=out;supPersist();
      }
      if(SUP_Q.length||SUP_DQ.length)supSync();else supNote('ok');
    }else{
      supNote(SUP_Q.length||SUP_DQ.length?'fail':'unreachable');
      if(SUP_Q.length||SUP_DQ.length)supSync();
    }
    supAutoRepeat();supBadge();
    var pg=supEl('page-supplies');if(pg&&pg.classList.contains('active'))renderSupplies();
  });
}

/* first run: starter repeat-order items + stores (fixed ids so two devices never duplicate them) */
function supSeed(){
  var done=false;try{done=localStorage.getItem(SUP_SEED_KEY)==='1';}catch(e){}
  if(done||SUP.length)return;
  [['trimmer_line','String trimmer line','spool'],['mix_fuel','Mixed fuel (2-cycle)','gal'],['two_cycle_oil','2-cycle oil','ea'],['bar_oil','Bar & chain oil','ea'],['mower_blades','Mower blades','ea'],['trash_bags','Trash bags (contractor)','box']].forEach(function(s){
    SUP.push({id:'seed_st_'+s[0],kind:'staple',name:s[1],qty:'1',unit:s[2],store:'Home Depot',method:'pickup',url:'',repeatEvery:'',repeatUnit:'months',nextDue:'',last:''});
  });
  ['Home Depot',"Lowe's",'Sun Belt Rentals','Tractor Supply','Ace Hardware'].forEach(function(n){SUP.push({id:'seed_store_'+n.toLowerCase().replace(/[^a-z0-9]+/g,'_'),kind:'store',name:n,address:''});});
  supPersist();try{localStorage.setItem(SUP_SEED_KEY,'1');}catch(e){}
}
function supStoreAddr(name){var n=String(name||'').toLowerCase();var s=supKind('store');for(var i=0;i<s.length;i++){if(String(s[i].name).toLowerCase()===n)return s[i].address||'';}return '';}
function supEnsureStore(name){
  name=String(name||'').trim();if(!name)return;
  var s=supKind('store');for(var i=0;i<s.length;i++){if(String(s[i].name).toLowerCase()===name.toLowerCase())return;}
  var rec={id:supUid(),kind:'store',name:name,address:''};SUP.push(rec);supTouch(rec);
}
function supOpen(){return supKind('item').filter(function(i){return i.status!=='picked';});}
function supBadge(){
  var n=supOpen().length,b=supEl('nav-sup-badge');if(!b)return;
  b.textContent=n;if(n>0)b.classList.add('show');else b.classList.remove('show');
}
function supSortFn(a,b){
  if((a.priority==='urgent')!==(b.priority==='urgent'))return a.priority==='urgent'?-1:1;
  var da=a.due||'9999-99-99',db=b.due||'9999-99-99';
  if(da!==db)return da<db?-1:1;
  return String(a.name).toLowerCase()<String(b.name).toLowerCase()?-1:1;
}
function supMapUrl(it){var q=[it.store,it.location,supStoreAddr(it.store)].filter(Boolean).join(' ');return q?'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(q):'';}

/* ---------- repeat orders ---------- */
function supAddInterval(from,n,unit){
  n=parseFloat(n)||0;var d=new Date((from||supToday())+'T12:00:00');
  if(unit==='days')d.setDate(d.getDate()+n);
  else if(unit==='weeks')d.setDate(d.getDate()+7*n);
  else{var day=d.getDate();d.setMonth(d.getMonth()+Math.round(n));if(d.getDate()!==day)d.setDate(0);}
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function supIsRepeat(s){return !!s&&parseFloat(s.repeatEvery)>0;}
function supRepLabel(s){var n=parseFloat(s.repeatEvery)||0;var u=s.repeatUnit||'months';return 'every '+n+' '+(n===1?u.replace(/s$/,''):u);}
/* ordered / picked up -> schedule the next reminder */
function supAdvanceFor(it){
  if(!it.rep||it.advanced||it.status==='needed')return;
  var s=it.stapleId?supFind(it.stapleId):null;if(!supIsRepeat(s))return;
  s.nextDue=supAddInterval(supToday(),s.repeatEvery,s.repeatUnit);supTouch(s);it.advanced=1;
  toast('Next reminder for '+s.name+': '+supFmtDate(s.nextDue));
}
/* when the reminder date arrives the item puts itself on the list (same id on every device, so no duplicates) */
function supAutoRepeat(){
  var today=supToday(),made=0;
  supKind('staple').forEach(function(s){
    if(!supIsRepeat(s)||!s.nextDue||s.nextDue>today)return;
    if(supOpen().some(function(i){return i.stapleId===s.id;}))return;
    var id='rep_'+s.id+'_'+s.nextDue;
    if(supFind(id)||SUP_DQ.indexOf(id)>=0)return;
    var rec={id:id,kind:'item',name:s.name,qty:s.qty||'1',unit:s.unit||'',store:s.store||'',location:'',due:s.nextDue,priority:'normal',orderNo:'',notes:'',method:s.method||'pickup',url:s.url||'',status:'needed',stapleId:s.id,rep:1,created:new Date().toISOString()};
    SUP.push(rec);supTouch(rec);made++;
  });
  if(made)toast(made+' repeat order'+(made===1?'':'s')+' added to Supplies');
  return made;
}
/* "repeat every N ..." on the add form creates / updates the linked repeat order */
function supApplyRepeat(rec){
  var n=parseFloat(supEl('sp-rep').value)||0,u=supEl('sp-repu').value;
  var s=rec.stapleId?supFind(rec.stapleId):null;
  if(!s){var ss=supKind('staple');for(var i=0;i<ss.length;i++){if(String(ss[i].name).toLowerCase()===String(rec.name).toLowerCase()){s=ss[i];break;}}}
  if(n>0){
    if(!s){s={id:supUid(),kind:'staple',name:rec.name,qty:rec.qty,unit:rec.unit,store:rec.store,last:'',nextDue:''};SUP.push(s);}
    s.method=rec.method;s.url=rec.url;s.repeatEvery=String(n);s.repeatUnit=u;
    rec.stapleId=s.id;rec.rep=1;supTouch(s);
    if(rec.status!=='needed'){rec.advanced=0;supAdvanceFor(rec);}
  }else if(s&&rec.rep){s.repeatEvery='';s.nextDue='';rec.rep=0;supTouch(s);}
}

/* ---------- add / edit an item ---------- */
function supBuildLists(){
  var sl=supEl('sp-store-list');
  if(sl)sl.innerHTML=supKind('store').filter(function(s){return s.name;}).map(function(s){return '<option value="'+supEsc(s.name)+'">';}).join('');
}
function supClearForm(){
  ['sp-name','sp-unit','sp-store','sp-loc','sp-due','sp-order','sp-notes','sp-url','sp-rep'].forEach(function(id){supEl(id).value='';});
  supEl('sp-qty').value='1';supEl('sp-method').value='pickup';supEl('sp-repu').value='months';supEl('sp-urgent').checked=false;
}
function supSubmit(){
  var name=supEl('sp-name').value.trim();
  if(!name){alert('Enter an item name.');supEl('sp-name').focus();return;}
  var obj={name:name,qty:supEl('sp-qty').value.trim(),unit:supEl('sp-unit').value.trim(),store:supEl('sp-store').value.trim(),location:supEl('sp-loc').value.trim(),due:supEl('sp-due').value,priority:supEl('sp-urgent').checked?'urgent':'normal',orderNo:supEl('sp-order').value.trim(),method:supEl('sp-method').value,url:supCleanUrl(supEl('sp-url').value),notes:supEl('sp-notes').value.trim()};
  var rec=SUP_EDIT?supFind(SUP_EDIT):null;
  if(rec){for(var k in obj)rec[k]=obj[k];toast('Item updated');}
  else{obj.id=supUid();obj.kind='item';obj.status='needed';obj.created=new Date().toISOString();rec=obj;SUP.push(rec);toast('Added to list');}
  supApplyRepeat(rec);supEnsureStore(obj.store);supTouch(rec);supCancelEdit();supAutoRepeat();renderSupplies();
}
function supEdit(id){
  var it=supFind(id);if(!it)return;SUP_EDIT=id;
  supEl('sp-name').value=it.name||'';supEl('sp-qty').value=it.qty||'';supEl('sp-unit').value=it.unit||'';
  supEl('sp-store').value=it.store||'';supEl('sp-loc').value=it.location||'';supEl('sp-due').value=it.due||'';supEl('sp-urgent').checked=it.priority==='urgent';
  supEl('sp-order').value=it.orderNo||'';supEl('sp-method').value=it.method||'pickup';supEl('sp-url').value=it.url||'';supEl('sp-notes').value=it.notes||'';
  var ls=it.stapleId?supFind(it.stapleId):null;
  supEl('sp-rep').value=(it.rep&&supIsRepeat(ls))?ls.repeatEvery:'';supEl('sp-repu').value=(ls&&ls.repeatUnit)||'months';
  supEl('sp-form-title').textContent='Edit item';
  supEl('sp-submit').textContent='Save changes';supEl('sp-cancel').style.display='inline-flex';
  if(it.location||it.url||it.orderNo||it.notes||it.priority==='urgent'){var d=supEl('sp-name').closest('.card').querySelector('details');if(d)d.open=true;}
  supEl('sp-name').scrollIntoView({behavior:'smooth',block:'center'});supEl('sp-name').focus();
}
function supCancelEdit(){
  SUP_EDIT=null;supClearForm();
  supEl('sp-form-title').textContent='Add to list';
  supEl('sp-submit').textContent='Add to list';supEl('sp-cancel').style.display='none';
}
function supDel(id){
  var it=supFind(id);if(!it)return;
  if(!confirm('Delete "'+it.name+'" from the list?'))return;
  if(SUP_EDIT===id)supCancelEdit();
  var s=(it.rep&&!it.advanced&&it.status==='needed'&&it.stapleId)?supFind(it.stapleId):null;
  if(supIsRepeat(s)){s.nextDue=supAddInterval(supToday(),s.repeatEvery,s.repeatUnit);supTouch(s);}
  supRemove(id);renderSupplies();toast(supIsRepeat(s)?'Skipped. Next reminder '+supFmtDate(s.nextDue):'Item deleted');
}
function supSetStatus(id,st){
  var it=supFind(id);if(!it)return;
  it.status=st;
  if(st==='picked'){it.pickedAt=new Date().toISOString();supMarkBought(it);}else it.pickedAt='';
  supAdvanceFor(it);
  supTouch(it);renderSupplies();
}
function supMarkBought(it){
  var ss=supKind('staple');
  for(var i=0;i<ss.length;i++){if(ss[i].id===it.stapleId||String(ss[i].name).toLowerCase()===String(it.name).toLowerCase()){ss[i].last=supToday();supTouch(ss[i]);break;}}
}
function supReorder(id){
  var it=supFind(id);if(!it)return;
  var c=supNorm(it);c.id=supUid();c.status='needed';c.due='';c.orderNo='';c.pickedAt='';c.rep=0;c.advanced=0;c.created=new Date().toISOString();
  SUP.push(c);supTouch(c);renderSupplies();toast(it.name+' added again');
}
function supPickGroup(idx){
  var ids=SUP_GROUP_IDS[idx]||[];
  if(!ids.length||!confirm('Mark '+ids.length+' item(s) as done?'))return;
  ids.forEach(function(id){var it=supFind(id);if(it&&it.status!=='picked'){it.status='picked';it.pickedAt=new Date().toISOString();supMarkBought(it);supAdvanceFor(it);supTouch(it);}});
  renderSupplies();
}
function supClearPicked(){
  var done=supKind('item').filter(function(i){return i.status==='picked';});
  if(!done.length){toast('Nothing to clear');return;}
  if(!confirm('Remove '+done.length+' finished item(s) from the list? Repeat orders stay.'))return;
  done.forEach(function(i){supRemove(i.id);});renderSupplies();
}

/* ---------- repeat order form ---------- */
function supSaveStaple(){
  var name=supEl('spt-name').value.trim();if(!name){alert('Enter an item name.');return;}
  var obj={name:name,qty:supEl('spt-qty').value.trim()||'1',unit:supEl('spt-unit').value.trim(),store:supEl('spt-store').value.trim(),method:supEl('spt-method').value,url:supCleanUrl(supEl('spt-url').value),repeatEvery:'',repeatUnit:supEl('spt-repu').value,nextDue:supEl('spt-next').value};
  var n=parseFloat(supEl('spt-rep').value)||0;
  if(n>0){obj.repeatEvery=String(n);if(!obj.nextDue)obj.nextDue=supAddInterval(supToday(),n,obj.repeatUnit);}else obj.nextDue='';
  var rec=SUP_EDIT_ST?supFind(SUP_EDIT_ST):null;
  if(rec){for(var k in obj)rec[k]=obj[k];}else{obj.id=supUid();obj.kind='staple';obj.last='';rec=obj;SUP.push(rec);}
  supEnsureStore(obj.store);supTouch(rec);supCancelStaple();supAutoRepeat();renderSupplies();toast('Saved');
}
function supEditStaple(id){
  var s=supFind(id);if(!s)return;SUP_EDIT_ST=id;
  supEl('spt-name').value=s.name||'';supEl('spt-qty').value=s.qty||'';supEl('spt-unit').value=s.unit||'';supEl('spt-store').value=s.store||'';
  supEl('spt-method').value=s.method||'pickup';supEl('spt-url').value=s.url||'';supEl('spt-rep').value=supIsRepeat(s)?s.repeatEvery:'';supEl('spt-repu').value=s.repeatUnit||'months';supEl('spt-next').value=s.nextDue||'';
  supEl('spt-cancel').style.display='inline-flex';supEl('spt-del').style.display='inline-flex';
  supEl('sp-st-sum').textContent='Edit: '+s.name;supEl('sp-st-det').open=true;
  supEl('spt-name').scrollIntoView({behavior:'smooth',block:'center'});supEl('spt-name').focus();
}
function supCancelStaple(){
  SUP_EDIT_ST=null;
  ['spt-name','spt-unit','spt-store','spt-url','spt-rep','spt-next'].forEach(function(id){supEl(id).value='';});
  supEl('spt-qty').value='1';supEl('spt-method').value='pickup';supEl('spt-repu').value='months';
  supEl('spt-cancel').style.display='none';supEl('spt-del').style.display='none';
  supEl('sp-st-sum').textContent='+ New repeat order';
}
function supDelStaple(){
  var s=SUP_EDIT_ST?supFind(SUP_EDIT_ST):null;if(!s||!confirm('Delete "'+s.name+'"?'))return;
  supRemove(s.id);supCancelStaple();renderSupplies();
}
function supAddStaple(id){
  var s=supFind(id);if(!s)return;
  if(supOpen().some(function(i){return String(i.name).toLowerCase()===String(s.name).toLowerCase();})&&!confirm('"'+s.name+'" is already on the list. Add another?'))return;
  var rec={id:supUid(),kind:'item',name:s.name,qty:s.qty||'1',unit:s.unit||'',store:s.store||'',location:'',due:'',priority:'normal',orderNo:'',notes:'',method:s.method||'pickup',url:s.url||'',rep:supIsRepeat(s)?1:0,status:'needed',stapleId:s.id,created:new Date().toISOString()};
  SUP.push(rec);supTouch(rec);renderSupplies();toast(s.name+' added to list');
}

/* ---------- stores ---------- */
function supAddStore(){var rec={id:supUid(),kind:'store',name:'',address:''};SUP.push(rec);supPersist();renderSupStores();var l=document.querySelectorAll('#sp-stores [data-sfield="name"]');if(l.length)l[l.length-1].focus();}
function supStoreEdit(id,field,v){var s=supFind(id);if(!s)return;s[field]=v.trim();if(s.name)supTouch(s);else supPersist();supBuildLists();supRenderList();}
function supDelStore(id){if(!confirm('Remove this store? (Items keep their store name.)'))return;supRemove(id);renderSupplies();}
function renderSupStores(){
  var el=supEl('sp-stores');if(!el)return;
  var h='';supKind('store').forEach(function(s){
    h+='<div class="sup-row" style="margin-bottom:6px;flex-wrap:nowrap"><input style="flex:1;min-width:0;padding:6px 8px;border:1px solid var(--br);border-radius:var(--ra);font:inherit;font-size:13px" data-sfield="name" data-id="'+supEsc(s.id)+'" placeholder="Store" value="'+supEsc(s.name)+'">'
      +'<input style="flex:1.6;min-width:0;padding:6px 8px;border:1px solid var(--br);border-radius:var(--ra);font:inherit;font-size:13px" data-sfield="address" data-id="'+supEsc(s.id)+'" placeholder="Address (for map link)" value="'+supEsc(s.address)+'">'
      +'<button class="btn btn-danger btn-xs" data-sact="delstore" data-id="'+supEsc(s.id)+'">&times;</button></div>';
  });
  el.innerHTML=h;
}

/* ---------- rendering ---------- */
function renderSupplies(){
  supAutoRepeat();supBuildLists();
  var em=supEl('sp-email');if(em&&!em.value){try{em.value=localStorage.getItem(SUP_MAIL_KEY)||'';}catch(e){}}
  supRenderStaples();supRenderList();renderSupStores();supBadge();supNote(SUP_Q.length||SUP_DQ.length?'':'ok');
  var btns=document.querySelectorAll('#sp-filter [data-sact="filter"]');
  for(var i=0;i<btns.length;i++){if(btns[i].getAttribute('data-id')===SUP_FILTER)btns[i].classList.add('on');else btns[i].classList.remove('on');}
  supEl('sp-clear').style.display=SUP_FILTER==='picked'?'inline-flex':'none';
}
function supRenderStaples(){
  var list=supKind('staple').sort(function(a,b){return String(a.name).toLowerCase()<String(b.name).toLowerCase()?-1:1;});
  var open=supOpen(),h='';
  list.forEach(function(s){
    var on=open.some(function(i){return String(i.name).toLowerCase()===String(s.name).toLowerCase();});
    var sub=[];
    if(s.store)sub.push(supEsc(s.store));
    if(supIsRepeat(s))sub.push('&#128257; '+supEsc(supRepLabel(s))+(s.nextDue?' - next '+supEsc(supFmtDate(s.nextDue)):''));
    h+='<div class="sup-st"><div class="sup-info"><div class="sup-title">'+supEsc(s.name)+'<span class="sup-qty">'+supEsc(s.qty||'')+' '+supEsc(s.unit||'')+'</span></div>'
      +(sub.length?'<div class="sup-meta">'+sub.join(' &middot; ')+'</div>':'')+'</div>'
      +'<div class="sup-act">'+(on?'<span class="sup-meta" style="color:var(--bl)">On list</span>':'<button class="btn btn-primary btn-xs" data-sact="staple-add" data-id="'+supEsc(s.id)+'">+ Add</button>')
      +'<button class="btn btn-secondary btn-xs" data-sact="staple-edit" data-id="'+supEsc(s.id)+'" title="Edit">&#9998;</button></div></div>';
  });
  supEl('sp-staples').innerHTML=h||'<div style="font-size:12px;color:var(--gr);margin-bottom:6px">Nothing yet. Add the things you buy again and again.</div>';
}
function supItemHtml(it){
  var id=supEsc(it.id),meta=[];
  var n=supDays(it.due);
  if(it.due){
    if(it.status==='picked')meta.push(supEsc(supFmtDate(it.due)));
    else if(n<0)meta.push('<span class="bad">Overdue '+(-n)+'d</span>');
    else if(n===0)meta.push('<span class="warn">Due today</span>');
    else if(n===1)meta.push('<span class="warn">Due tomorrow</span>');
    else meta.push('Due '+supEsc(supFmtDate(it.due)));
  }
  if(it.method==='order'){meta.push('Order online'+(supSafeUrl(it.url)?' - <a href="'+supEsc(supSafeUrl(it.url))+'" target="_blank" rel="noopener">open link</a>':''));}
  else if(it.location||it.store){var map=supMapUrl(it);meta.push(supEsc(it.location||'')+(it.location&&map?' ':'')+(map?'<a href="'+map+'" target="_blank" rel="noopener">map</a>':''));}
  if(it.orderNo)meta.push('Order # '+supEsc(it.orderNo));
  if(it.rep)meta.push('&#128257; repeats');
  function opt(v,l){return '<option value="'+v+'"'+(it.status===v?' selected':'')+'>'+l+'</option>';}
  return '<div class="sup-item st-'+it.status+(it.priority==='urgent'&&it.status!=='picked'?' urgent':'')+'">'
    +'<div class="sup-info"><div class="sup-title">'+(it.priority==='urgent'?'&#128293; ':'')+supEsc(it.name)+(it.qty?'<span class="sup-qty">'+supEsc(it.qty)+' '+supEsc(it.unit||'')+'</span>':'')+'</div>'
    +(meta.length?'<div class="sup-meta">'+meta.join('<span>&middot;</span>')+'</div>':'')
    +(it.notes?'<div class="sup-note">'+supEsc(it.notes)+'</div>':'')+'</div>'
    +'<div class="sup-act"><select data-sact="status" data-id="'+id+'">'+opt('needed','To get')+opt('ordered','Ordered')+opt('picked','Done')+'</select>'
    +(it.status==='picked'?'<button class="btn btn-secondary btn-xs" data-sact="reorder" data-id="'+id+'" title="Add to the list again">&#10227;</button>':'')
    +'<button class="btn btn-secondary btn-xs" data-sact="edit" data-id="'+id+'" title="Edit">&#9998;</button>'
    +'<button class="btn btn-secondary btn-xs" data-sact="del" data-id="'+id+'" title="Delete">&#128465;</button></div></div>';
}
function supRenderList(){
  var items=supKind('item').filter(function(it){return SUP_FILTER==='open'?it.status!=='picked':it.status==='picked';}).sort(supSortFn);
  var late=supOpen().filter(function(i){var n=supDays(i.due);return n!==null&&n<0;}).length;
  supEl('sp-count').textContent=items.length+(SUP_FILTER==='open'&&late?' - '+late+' overdue':'');
  if(!items.length){SUP_GROUP_IDS=[];supEl('sp-list').innerHTML='<div class="sup-empty">'+(SUP_FILTER==='open'?'Nothing to get. Add an item, or tap <b>+ Add</b> on a repeat order.':'Nothing finished yet.')+'</div>';return;}
  var groups={},order=[];
  items.forEach(function(it){var k=it.store||'(No store)';if(!groups[k]){groups[k]=[];order.push(k);}groups[k].push(it);});
  order.sort(function(a,b){var an=a.charAt(0)==='(',bn=b.charAt(0)==='(';if(an!==bn)return an?1:-1;return a.toLowerCase()<b.toLowerCase()?-1:1;});
  SUP_GROUP_IDS=[];
  supEl('sp-list').innerHTML=order.map(function(k,idx){
    var g=groups[k];SUP_GROUP_IDS[idx]=g.filter(function(i){return i.status!=='picked';}).map(function(i){return i.id;});
    return '<div class="sup-gh"><div>'+supEsc(k)+'<small>'+g.length+'</small></div>'
      +(SUP_GROUP_IDS[idx].length>1?'<button class="btn btn-secondary btn-xs no-print" data-sact="pickgroup" data-id="'+idx+'">All done</button>':'')+'</div>'
      +g.map(supItemHtml).join('');
  }).join('');
}

/* ---------- print / copy / email: open items by store, no prices ---------- */
function supStoreGroups(){
  var g={},order=[];
  supOpen().sort(supSortFn).forEach(function(it){var k=it.store||'(No store)';if(!g[k]){g[k]=[];order.push(k);}g[k].push(it);});
  order.sort(function(a,b){var an=a.charAt(0)==='(',bn=b.charAt(0)==='(';if(an!==bn)return an?1:-1;return a.toLowerCase()<b.toLowerCase()?-1:1;});
  return order.map(function(k){return {store:k,items:g[k]};});
}
function supItemLine(it){
  var b=[it.name+(it.qty?' - '+it.qty+(it.unit?' '+it.unit:''):'')];
  if(it.priority==='urgent')b.push('URGENT');
  if(it.due)b.push('by '+supFmtDate(it.due));
  if(it.method==='order')b.push('ORDER ONLINE'+(supSafeUrl(it.url)?' '+it.url:''));
  if(it.location)b.push('at '+it.location);
  if(it.orderNo)b.push('order # '+it.orderNo);
  var s=b.join(' | ');
  if(it.notes)s+=' ('+String(it.notes).replace(/\s*\n\s*/g,'; ')+')';
  return s;
}
function supListText(){
  var gs=supStoreGroups();if(!gs.length)return '';
  var L=['WS Lawn Care - Supply List ('+supFmtDate(supToday())+')',''];
  gs.forEach(function(g){
    var a=supStoreAddr(g.store);L.push(g.store.toUpperCase()+(a?' - '+a:''));
    g.items.forEach(function(it){L.push('  [ ] '+supItemLine(it));});L.push('');
  });
  return L.join('\n').trim();
}
function supCopy(){
  var t=supListText();if(!t){alert('No open items to copy.');return;}
  var ok=function(){toast('List copied');};
  var legacy=function(){var ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');ok();}catch(e){alert('Could not copy.');}ta.remove();};
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(ok,legacy);else legacy();
}
function supEmail(mode){
  var raw=(supEl('sp-email').value||'').trim(),list=raw.split(/[,;\s]+/).filter(Boolean);
  var bad=list.filter(function(a){return !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(a);});
  if(!list.length||bad.length){alert(bad.length?'This email address looks invalid: '+bad[0]:'Enter at least one email address first.');return;}
  var body=supListText();if(!body){alert('No open items to send.');return;}
  try{localStorage.setItem(SUP_MAIL_KEY,list.join(', '));}catch(e){}
  var subject='Supply List - '+supFmtDate(supToday()),enc=encodeURIComponent;
  var make=function(b){return mode==='mailto'?'mailto:'+list.map(enc).join(',')+'?subject='+enc(subject)+'&body='+enc(b):'https://mail.google.com/mail/?view=cm&fs=1&to='+enc(list.join(','))+'&su='+enc(subject)+'&body='+enc(b);};
  var url=make(body);
  if(url.length>7000){
    if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(body).catch(function(){});
    url=make('(The list is too long to pre-fill. It was copied to your clipboard. Paste it here.)');
    alert('The list is long, so it was copied to your clipboard. Paste it into the email body.');
  }
  var a=document.createElement('a');a.href=url;a.target='_blank';a.rel='noopener';document.body.appendChild(a);a.click();a.remove();
}
function supPrint(){
  var gs=supStoreGroups();if(!gs.length){alert('No open items to print.');return;}
  var css='*{box-sizing:border-box;margin:0;padding:0}body{font-family:Arial,sans-serif;padding:22px;max-width:820px;margin:0 auto;color:#1a1a1a;font-size:13px}.hdr{border-bottom:3px solid #2d6a2f;padding-bottom:10px;margin-bottom:14px}.co{font-size:20px;font-weight:700;color:#2d6a2f}.sub{font-size:11px;color:#555;margin-top:3px}h2{font-size:15px;color:#2d6a2f;margin:16px 0 4px;border-bottom:2px solid #c8e6c9;padding-bottom:3px}h2 small{font-weight:400;font-size:11px;color:#555}table{width:100%;border-collapse:collapse;font-size:12px}th{background:#f0f7f0;padding:5px 7px;text-align:left;border:1px solid #ddd;font-size:10px;text-transform:uppercase}td{padding:6px 7px;border:1px solid #ddd;vertical-align:top}.chk{width:26px;text-align:center;font-size:15px}.u{color:#c62828;font-weight:700}.footer{margin-top:24px;text-align:center;font-size:10px;color:#999;border-top:1px solid #eee;padding-top:8px}';
  var body='<div class="hdr"><div class="co">Supply List</div><div class="sub">WS Lawn Care Services, LLC - '+supEsc(supFmtDate(supToday()))+'</div></div>';
  gs.forEach(function(g){
    var a=supStoreAddr(g.store);
    body+='<h2>'+supEsc(g.store)+(a?' <small>- '+supEsc(a)+'</small>':'')+'</h2><table><tr><th></th><th>Item</th><th>Qty</th><th>By</th><th>Details</th></tr>';
    g.items.forEach(function(it){
      var det=[it.method==='order'?'ORDER ONLINE'+(supSafeUrl(it.url)?' '+it.url:''):'',it.location,it.orderNo?'Order # '+it.orderNo:'',it.notes].filter(Boolean).map(supEsc).join(' - ');
      body+='<tr><td class="chk">&#9744;</td><td><b>'+(it.priority==='urgent'?'<span class="u">URGENT</span> ':'')+supEsc(it.name)+'</b></td><td>'+supEsc((it.qty||'')+' '+(it.unit||''))+'</td><td>'+supEsc(supFmtDate(it.due))+'</td><td>'+det+'</td></tr>';
    });
    body+='</table>';
  });
  body+='<div class="footer">"Jesus First Before Profits" - WS Lawn Care Services, LLC - Titusville, FL - 321-209-0668</div>';
  var w=window.open('','_blank','width=870,height=1050');
  if(!w){alert('Your browser blocked the pop-up. Allow pop-ups for this page and try again.');return;}
  w.document.write('<!DOCTYPE html><html><head><title>WS Lawn Care Supply List</title><style>'+css+'</style></head><body>'+body+'<script>window.onload=function(){window.print();}<\/script></body></html>');
  w.document.close();
}

/* ---------- backup ---------- */
function supExport(){
  var blob=new Blob([JSON.stringify({supplies:SUP,exported:new Date().toISOString()},null,2)],{type:'application/json'});
  var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ws-supplies-backup-'+supToday()+'.json';
  document.body.appendChild(a);a.click();a.remove();
}
function supImport(file){
  if(!file)return;
  var r=new FileReader();
  r.onload=function(){
    try{
      var d=JSON.parse(r.result),arr=Array.isArray(d)?d:d.supplies;
      if(!Array.isArray(arr))throw new Error('bad');
      if(!confirm('Replace the current supplies with this backup ('+arr.length+' records)?'))return;
      SUP.forEach(function(x){if(SUP_DQ.indexOf(x.id)<0)SUP_DQ.push(x.id);});
      SUP=arr.filter(function(x){return x&&x.id;}).map(supNorm);
      SUP_DQ=SUP_DQ.filter(function(id){return !SUP.some(function(x){return x.id===id;});});supSaveDQ();
      SUP_Q=SUP.map(function(x){return x.id;});supSaveQ();supPersist();supSync();
      renderSupplies();toast('Backup restored');
    }catch(e){alert('That file is not a valid supplies backup.');}
    var inp=supEl('sp-import');if(inp)inp.value='';
  };
  r.readAsText(file);
}

/* ---------- events (data attributes, no arguments in onclick) ---------- */
function supAct(act,id){
  if(act==='submit')supSubmit();
  else if(act==='cancel')supCancelEdit();
  else if(act==='edit')supEdit(id);
  else if(act==='del')supDel(id);
  else if(act==='reorder')supReorder(id);
  else if(act==='pickgroup')supPickGroup(parseInt(id,10));
  else if(act==='filter'){SUP_FILTER=id;renderSupplies();}
  else if(act==='staple-add')supAddStaple(id);
  else if(act==='staple-edit')supEditStaple(id);
  else if(act==='st-submit')supSaveStaple();
  else if(act==='st-cancel')supCancelStaple();
  else if(act==='st-del')supDelStaple();
  else if(act==='addstore')supAddStore();
  else if(act==='delstore')supDelStore(id);
  else if(act==='print')supPrint();
  else if(act==='copy')supCopy();
  else if(act==='emailtoggle'){var r=supEl('sp-email-row');r.style.display=r.style.display==='none'?'flex':'none';}
  else if(act==='email-gmail')supEmail('gmail');
  else if(act==='email-mailto')supEmail('mailto');
  else if(act==='clearpicked')supClearPicked();
  else if(act==='export')supExport();
}
function initSupplies(){
  var pg=supEl('page-supplies');if(!pg)return;
  pg.addEventListener('click',function(ev){
    var b=ev.target.closest?ev.target.closest('[data-sact]'):null;
    if(!b||b.tagName==='SELECT')return;
    supAct(b.getAttribute('data-sact'),b.getAttribute('data-id'));
  });
  pg.addEventListener('change',function(ev){
    var t=ev.target;if(!t||!t.getAttribute)return;
    if(t.getAttribute('data-sact')==='status')supSetStatus(t.getAttribute('data-id'),t.value);
    else if(t.getAttribute('data-sfield'))supStoreEdit(t.getAttribute('data-id'),t.getAttribute('data-sfield'),t.value);
    else if(t.id==='sp-import')supImport(t.files&&t.files[0]);
  });
  supSeed();
  supAutoRepeat();
  supBadge();
  if(API_URL)supPull();
}
function navSupplies(){nav('supplies',null);}
window.navSupplies=navSupplies;
initSupplies();

/* ================= PHONE APP SHELL =================
   Bottom tab bar + "More" sheet. Only visible at <=700px (CSS).
   Buttons use data-fn so there are no arguments in onclick (Wix-safe). */
var TB_MAP={dashboard:'dashboard',equipment:'equipment',detail:'equipment',bulkhours:'bulkhours',repairs:'repairs'};
function tbSync(id){
  var want=TB_MAP[id]||'more';
  var items=document.querySelectorAll('.tb-item');
  for(var i=0;i<items.length;i++){if(items[i].getAttribute('data-tb')===want)items[i].classList.add('on');else items[i].classList.remove('on');}
  if(window.innerWidth<=700){try{window.scrollTo(0,0);}catch(e){}var m=document.querySelector('.main');if(m)m.scrollTop=0;}
}
function openMore(){document.getElementById('more-sheet').classList.add('open');document.getElementById('more-back').classList.add('open');}
function closeMore(){document.getElementById('more-sheet').classList.remove('open');document.getElementById('more-back').classList.remove('open');}
(function(){
  function run(ev){
    var b=ev.target.closest?ev.target.closest('[data-fn]'):null;if(!b)return;
    var fn=b.getAttribute('data-fn');
    if(fn!=='openMore')closeMore();
    if(typeof window[fn]==='function')window[fn]();
  }
  var tb=document.getElementById('tabbar'),sh=document.getElementById('more-sheet'),bk=document.getElementById('more-back');
  if(tb)tb.addEventListener('click',run);
  if(sh)sh.addEventListener('click',run);
  if(bk)bk.addEventListener('click',closeMore);
  window.addEventListener('resize',function(){if(window.innerWidth>700)closeMore();});
})();
window.openMore=openMore;window.closeMore=closeMore;

/* Expose all onclick-called functions on window for Wix iframe compatibility */
window.navDashboard = navDashboard;
window.navEquipment = navEquipment;
window.navWorkorders = navWorkorders;
window.navCalendar = navCalendar;
window.navBulkhours = navBulkhours;
window.openAddEquip = openAddEquip;
window.printSelectedWO = printSelectedWO;
window.navWorkorders = navWorkorders;
window.updHrs = updHrs;
window.updMi = updMi;
window.dTabIntervals = dTabIntervals;
window.dTabHistory = dTabHistory;
window.dTabSpecs = dTabSpecs;
window.setWFAll = setWFAll;
window.setWFOverdue = setWFOverdue;
window.setWFDue = setWFDue;
window.selAllTrue = selAllTrue;
window.selAllFalse = selAllFalse;
window.chMo = chMo;
window.bulkReset = bulkReset;
window.bulkSave = bulkSave;
window.closeMEquip = closeMEquip;
window.addII = addII;
window.saveEquip = saveEquip;
window.closeMSvc = closeMSvc;
window.saveSvc = saveSvc;
window.closeMApi = closeMApi;
window.openEditEquip = openEditEquip;
window.delEquip = delEquip;
window.openLogSvc = openLogSvc;
window.forceSync = forceSync;
window.openApiSetup = openApiSetup;
window.saveApiUrl = saveApiUrl;
window.testApiConnection = testApiConnection;
window.handleMgrNote = handleMgrNote;
window.handleBulkInput = handleBulkInput;

/* ---- FIELD APP (WS Quick) LINK / INSTALL HELP ---- */
function fqUrl(){try{return new URL('quick.html',location.href).href;}catch(e){return 'quick.html';}}
function fqOpen(){window.open(fqUrl(),'_blank');}
function fqCopy(){
  var u=fqUrl();
  var ok=function(){toast('Field app link copied');};
  var old=function(){var t=document.createElement('textarea');t.value=u;document.body.appendChild(t);t.select();try{document.execCommand('copy');ok();}catch(e){prompt('Copy this link:',u);}t.remove();};
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(u).then(ok,old);else old();
}
function fqText(){
  var msg='WS Lawn Care field app - open this, then tap Install / Add to Home Screen: '+fqUrl();
  var a=document.createElement('a');a.href='sms:?&body='+encodeURIComponent(msg);document.body.appendChild(a);a.click();a.remove();
}
function fqSteps(){var el=document.getElementById('fq-steps');if(el)el.classList.toggle('open');}
window.fqOpen=fqOpen;window.fqCopy=fqCopy;window.fqText=fqText;window.fqSteps=fqSteps;


</script>
</body>
</html>
